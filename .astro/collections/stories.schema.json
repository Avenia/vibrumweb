{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "coverImage": {
      "type": "string"
    },
    "guitar": {
      "type": "string"
    },
    "category": {
      "default": "build-diary",
      "type": "string",
      "enum": [
        "build-diary",
        "in-the-wild",
        "news"
      ]
    },
    "excerpt": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "coverImage",
    "excerpt"
  ]
}