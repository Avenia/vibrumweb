---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import HeroShow from '../components/HeroShow.astro';
import GuitarStrip from '../components/GuitarStrip.astro';
import PageLogoBg from '../components/PageLogoBg.astro';
import WorkshopStoryCard from '../components/WorkshopStoryCard.astro';
import BenchLetter from '../components/BenchLetter.astro';

const stories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = stories[0];
const workshopStories = stories.slice(1);

const WORKSHOP_PAGE_SIZE = 6;        // desktop
const WORKSHOP_PAGE_SIZE_MOBILE = 4; // ≤639px — applied client-side in the script below

const guitars = (await getCollection('guitars'))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 6);
---

<PageLayout
  title="Vibrum | Handcrafted guitars"
  description="Handcrafted guitars made by Vibrum, where traditional craftsmanship meets design. We are dedicated to creating unique, high-quality instruments that inspire musicians worldwide."
>
  <PageLogoBg reveal />

  <HeroShow />

  {featured && (
    <section class="bench-feature">
      <img class="bench-feature-img" src={featured.data.coverImage} alt="" loading="lazy" />
      <div class="bench-feature-shade" aria-hidden="true"></div>
      <div class="bench-feature-inner container">
        <p class="eyebrow">From the bench</p>
        <h2 class="bench-feature-title">
          <a href={`/stories/${featured.slug}`}>{featured.data.title}</a>
        </h2>
        <p class="bench-feature-excerpt">{featured.data.excerpt}</p>
        <a class="bench-feature-link" href={`/stories/${featured.slug}`}>Read the story →</a>
      </div>
    </section>
  )}

  {guitars.length > 0 && (
    <section class="guitar-band">
      <img
        class="guitar-band-img"
        src="/images/guitars/pyrocaster/photo-19.png"
        alt=""
        loading="lazy"
      />
      <div class="guitar-band-shade" aria-hidden="true"></div>
      <div class="guitar-band-inner container section">
        <div class="section-header">
          <h2 class="section-heading">Recent guitars</h2>
        </div>

        <GuitarStrip guitars={guitars} />
      </div>
    </section>
  )}

  {(workshopStories.length > 0 || stories.length === 0) && (
    <section class="workshop-band" id="stories">
      <img
        class="workshop-band-img"
        src="/images/guitars/driftwood-om/photo-15.png"
        alt=""
        loading="lazy"
      />
      <div class="workshop-band-shade" aria-hidden="true"></div>
      <div class="container section workshop-section workshop-band-inner">
        <div class="section-header">
          <h2 class="section-heading">More from the workshop</h2>
        </div>

        {workshopStories.length > 0 ? (
          <>
            <div
              class="workshop-grid"
              id="workshop-grid"
              data-page-size={WORKSHOP_PAGE_SIZE}
              data-page-size-mobile={WORKSHOP_PAGE_SIZE_MOBILE}
            >
              {workshopStories.map((story, i) => (
                <div class="story-reveal" data-ws-index={i} hidden={i >= WORKSHOP_PAGE_SIZE}>
                  <WorkshopStoryCard
                    title={story.data.title}
                    slug={story.slug}
                    date={story.data.date}
                    coverImage={story.data.coverImage}
                    excerpt={story.data.excerpt}
                    category={story.data.category}
                  />
                </div>
              ))}
            </div>
            {workshopStories.length > WORKSHOP_PAGE_SIZE_MOBILE && (
              <div class="workshop-dots" role="group" aria-label="Story pages"></div>
            )}
            {workshopStories.length > WORKSHOP_PAGE_SIZE_MOBILE && (
              <div class="workshop-nav workshop-nav--bottom">
                <button class="workshop-arrow ws-prev" aria-label="Previous stories" disabled>&#8592;</button>
                <span class="workshop-page ws-page" aria-live="polite">
                  1 / {Math.ceil(workshopStories.length / WORKSHOP_PAGE_SIZE)}
                </span>
                <button class="workshop-arrow ws-next" aria-label="More stories">&#8594;</button>
              </div>
            )}
          </>
        ) : (
          <div class="empty-state">
            <p>Stories coming soon. Check back after the first build.</p>
            <a href="/gallery" class="empty-cta">Browse the gallery →</a>
          </div>
        )}
      </div>
    </section>
  )}

  <BenchLetter />
</PageLayout>

<style>
  .container {
    position: relative;
    z-index: 1;
  }

  /* =========================================
     Section titles — same style as the
     contact page's .eyebrow
     ========================================= */
  .eyebrow,
  .section-heading {
    /* Explicit family so the h2 titles don't pick up the global heading serif. */
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 18px;
  }

  /* =========================================
     Section header — heading + optional link
     over a hairline rule
     ========================================= */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm);
    border-bottom: 1px solid rgba(255, 245, 220, 0.14);
    padding-bottom: 16px;
    margin-bottom: 40px;
  }

  .section-heading {
    margin: 0; /* the .section-header row handles the spacing */
  }

  /* =========================================
     From the bench — featured story banner
     ========================================= */
  .bench-feature {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 480px;
    overflow: hidden;
    background: var(--color-bg);
  }

  .bench-feature-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .bench-feature-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(10, 9, 6, 0.94) 0%,
      rgba(10, 9, 6, 0.62) 55%,
      rgba(10, 9, 6, 0.35) 100%
    );
  }

  /* Copy spans the full width on small screens, so shade the whole image. */
  @media (max-width: 639px) {
    .bench-feature-shade {
      background: linear-gradient(
        to right,
        rgba(10, 9, 6, 0.92) 0%,
        rgba(10, 9, 6, 0.72) 100%
      );
    }
  }

  .bench-feature-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-lg);
  }

  .bench-feature-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.15;
    color: #EDE7D4;
    margin: 0 0 16px;
    max-width: 640px;
  }

  .bench-feature-title a {
    transition: color var(--transition);
  }

  .bench-feature-title a:hover {
    color: var(--color-accent);
  }

  .bench-feature-excerpt {
    font-size: 1.02rem;
    line-height: 1.7;
    color: rgba(255, 245, 220, 0.62);
    max-width: 560px;
    margin: 0 0 28px;
  }

  .bench-feature-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #EDE7D4;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 6px;
    transition: color var(--transition);
  }

  .bench-feature-link:hover {
    color: var(--color-accent);
  }

  /* =========================================
     More from the workshop
     ========================================= */
  .workshop-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .workshop-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .workshop-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      row-gap: var(--space-lg);
    }
  }

  @media (max-width: 639px) {
    .workshop-section .section-header,
    .guitar-band-inner .section-header {
      margin-bottom: var(--space-md);
    }
  }

  /* Scroll-triggered card reveals */
  .story-reveal {
    opacity: 0;
    transform: translateY(28px); /* default: waiting below, enter from bottom */
    transition: opacity 0.55s ease-out, transform 0.55s ease-out;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .story-reveal.from-top {
    transform: translateY(-28px); /* waiting above, enter from top */
  }

  .story-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .story-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .empty-state {
    color: var(--color-text-muted);
    padding: var(--space-lg) 0;
  }

  .empty-cta {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-accent);
    font-size: 0.9rem;
    transition: opacity var(--transition);
  }

  .empty-cta:hover {
    opacity: 0.7;
  }

  /* =========================================
     More from the workshop — full-bleed band
     with paged story grid
     ========================================= */
  .workshop-band {
    position: relative;
    overflow: hidden;
    /* Anchor target for /#stories — clear the fixed nav */
    scroll-margin-top: var(--nav-height);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .workshop-band-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the mahogany body (lower half of the source photo) in frame. */
    object-position: center 62%;
  }

  /* Same heavy edge-melting veil as the guitars band below. */
  .workshop-band-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 6, 0.97) 0%,
      rgba(10, 9, 6, 0.9) 32%,
      rgba(10, 9, 6, 0.9) 68%,
      rgba(10, 9, 6, 0.97) 100%
    );
  }

  .workshop-band-inner {
    z-index: 1;
  }

  .workshop-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* JS hides the pager when everything fits on one page; the display
     rules below would otherwise override the hidden attribute. */
  .workshop-nav[hidden] {
    display: none !important;
  }

  /* Page dots under the grid (desktop) — same recipe as the hero dots. */
  .workshop-dots {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: var(--space-md);
  }

  .workshop-dots[hidden] {
    display: none !important;
  }

  /* Dots are created by the script below, so they don't carry Astro's
     scope attribute — style them via :global() under the scoped wrap. */
  .workshop-dots :global(.workshop-dot) {
    width: 6px;
    height: 6px;
    opacity: 0.7;
    border-radius: 3px;
    border: none;
    background: rgba(255, 245, 220, 0.35);
    cursor: pointer;
    padding: 0;
    transition: background var(--transition), transform 0.3s ease;
  }

  .workshop-dots :global(.workshop-dot.active) {
    background: var(--color-accent);
    transform: scale(1.35);
  }

  @media (max-width: 639px) {
    /* Mobile pages with the arrows + count row below the grid instead. */
    .workshop-dots {
      display: none;
    }
  }

  /* The arrows + count row is mobile-only, sitting below the stories
     so you page forward right where you finished reading. Desktop
     pages with the dots instead. */
  .workshop-nav--bottom {
    display: none;
  }

  @media (max-width: 639px) {
    .workshop-nav--bottom {
      display: flex;
      justify-content: center;
      margin-top: var(--space-md);
    }
  }

  .workshop-page {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: rgba(255, 245, 220, 0.45);
    white-space: nowrap;
  }

  .workshop-arrow {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(10, 9, 6, 0.6);
    border: 1px solid var(--color-border);
    color: var(--color-text-bold);
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
    transition: background var(--transition), border-color var(--transition), opacity var(--transition);
  }

  .workshop-arrow:hover:not(:disabled) {
    background: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .workshop-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* =========================================
     Recent guitars — full-bleed strip band
     ========================================= */
  .guitar-band {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    /* Bottom hairline comes from .bench-letter's border-top right below,
       so the two bands share a single rule instead of doubling up. */
    background: var(--color-bg);
  }

  .guitar-band-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* Heavy veil, deepening toward the edges so the band melts
     into the page background above and the letter band below. */
  .guitar-band-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 6, 0.97) 0%,
      rgba(10, 9, 6, 0.88) 32%,
      rgba(10, 9, 6, 0.88) 68%,
      rgba(10, 9, 6, 0.97) 100%
    );
  }

  .guitar-band-inner {
    /* Block padding comes from .section, same as the workshop band,
       so both section labels sit identically inside their bands. */
    z-index: 1;
  }

</style>

<script>
  // --- Reveal the fixed logo watermark once the hero is scrolled past ---
  const logoBg = document.querySelector('.page-logo-bg') as HTMLElement | null;
  const hero = document.getElementById('hero');
  if (logoBg && hero) {
    new IntersectionObserver(
      ([entry]) => logoBg.classList.toggle('is-visible', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);
  }

  // --- Scroll-triggered story card reveals ---
  const cards = document.querySelectorAll<HTMLElement>('.story-reveal');

  // Stagger by column so each row cascades left→right on the 3-column grid.
  cards.forEach((card, i) => {
    card.style.setProperty('--reveal-delay', `${(i % 3) * 120}ms`);
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        const el = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          el.classList.add('is-visible');
          el.classList.remove('from-top');
        } else {
          el.classList.remove('is-visible');
          // Prep slide direction for next entry:
          // top < 0 → card exited above → next entry comes from top
          // top > 0 → card exited below → next entry comes from bottom (default)
          if (entry.boundingClientRect.top < 0) {
            el.classList.add('from-top');
          } else {
            el.classList.remove('from-top');
          }
        }
      });
    },
    { threshold: 0.08 }
  );

  cards.forEach(card => observer.observe(card));

  // --- Workshop story pagination (6 per page) ---
  // Two nav instances (header row on desktop, below the grid on mobile)
  // stay in sync; both drive the same page state.
  const wsGrid = document.getElementById('workshop-grid');
  const wsPrevBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.ws-prev'));
  const wsNextBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.ws-next'));
  const wsPageEls = Array.from(document.querySelectorAll<HTMLElement>('.ws-page'));

  if (wsGrid && wsPrevBtns.length && wsNextBtns.length) {
    const items = Array.from(wsGrid.querySelectorAll<HTMLElement>('[data-ws-index]'));
    const navEls = Array.from(document.querySelectorAll<HTMLElement>('.workshop-nav'));
    const dotsWrap = document.querySelector<HTMLElement>('.workshop-dots');
    const mobileQuery = window.matchMedia('(max-width: 639px)');

    const desktopPageSize = Number(wsGrid.dataset.pageSize) || 6;
    const mobilePageSize = Number(wsGrid.dataset.pageSizeMobile) || 4;

    let pageSize = mobileQuery.matches ? mobilePageSize : desktopPageSize;
    let pageCount = Math.ceil(items.length / pageSize);
    let page = 0;
    // Height of a full desktop page, refreshed on every full-page render.
    let fullPageHeight = 0;

    function renderPage() {
      const start = page * pageSize;
      const end = start + pageSize;
      items.forEach((item, i) => {
        const visible = i >= start && i < end;
        item.hidden = !visible;
        // Newly shown cards should be readable immediately, not wait for a
        // scroll event to re-trigger the reveal observer.
        if (visible) item.classList.add('is-visible');
      });
      // Desktop: a partial last page would shrink the section and make
      // the dots and the band jump around. Pin the grid to the height
      // of a full page (measured live, so images/fonts/resizes are
      // accounted for) and let the last page have empty space instead.
      // Mobile stacks cards in one column and just stays shorter.
      const partial = items.length - start < pageSize;
      if (mobileQuery.matches) {
        wsGrid!.style.minHeight = '';
      } else if (partial) {
        if (fullPageHeight > 0) wsGrid!.style.minHeight = `${fullPageHeight}px`;
      } else {
        wsGrid!.style.minHeight = '';
        fullPageHeight = wsGrid!.offsetHeight;
      }
      wsPrevBtns.forEach(b => { b.disabled = page === 0; });
      wsNextBtns.forEach(b => { b.disabled = page === pageCount - 1; });
      wsPageEls.forEach(el => { el.textContent = `${page + 1} / ${pageCount}`; });
      // A single page needs no pager (e.g. 5 stories on desktop).
      navEls.forEach(el => { el.hidden = pageCount <= 1; });
      if (dotsWrap) {
        dotsWrap.hidden = pageCount <= 1;
        dotsWrap.querySelectorAll<HTMLElement>('.workshop-dot').forEach((dot, i) => {
          dot.classList.toggle('active', i === page);
          if (i === page) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      }
    }

    // One dot per page; rebuilt when the breakpoint flips page size.
    function buildDots() {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      for (let i = 0; i < pageCount; i++) {
        const dot = document.createElement('button');
        dot.className = 'workshop-dot';
        dot.setAttribute('aria-label', `Go to stories page ${i + 1}`);
        dot.addEventListener('click', () => goToPage(i, true));
        dotsWrap.appendChild(dot);
      }
    }

    // The server renders the desktop page size; re-render on load so
    // mobile starts with its own, and again when the breakpoint flips
    // (rotation, resize) — keeping the first visible story in view.
    mobileQuery.addEventListener('change', () => {
      const firstIndex = page * pageSize;
      pageSize = mobileQuery.matches ? mobilePageSize : desktopPageSize;
      pageCount = Math.ceil(items.length / pageSize);
      page = Math.min(Math.floor(firstIndex / pageSize), pageCount - 1);
      buildDots();
      renderPage();
    });

    buildDots();
    renderPage();

    // The full-page height measurement shifts when the web fonts swap
    // in or the columns change width — re-render (and so re-measure)
    // when that happens. On a full page this refreshes the stored
    // height; on a partial page it re-applies the pin.
    document.fonts?.ready.then(() => renderPage());
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(renderPage, 150);
    });

    // Scroll so "More from the workshop" is the first thing in view and
    // resolve once the scroll settles, so the caller can swap the page
    // content only after the reader is back at the top of the section.
    function scrollToSectionTop(): Promise<void> {
      return new Promise((resolve) => {
        const header = wsGrid!.closest('.workshop-band')?.querySelector('.section-header') ?? wsGrid!;
        const navHeight = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--nav-height')
        ) || 70;
        const top = Math.max(0, header.getBoundingClientRect().top + window.scrollY - navHeight - 16);

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          window.scrollTo({ top });
          resolve();
          return;
        }

        window.scrollTo({ top, behavior: 'smooth' });

        // No reliable cross-browser scrollend yet, so poll: done when we
        // reach the target or the position stops moving (~100ms idle).
        const deadline = performance.now() + 2000;
        let last = -1;
        let idleFrames = 0;
        function tick() {
          const y = window.scrollY;
          if (Math.abs(y - top) < 2 || performance.now() > deadline) return resolve();
          if (y === last) {
            if (++idleFrames > 6) return resolve();
          } else {
            idleFrames = 0;
            last = y;
          }
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    }

    let paging = false;

    // scrollFirst: ride up to the section header, then swap — the old
    // page stays put while the view travels. Used by the mobile bottom
    // nav and the dots under the grid, both of which sit below the
    // stories. The desktop header arrows are already in view, so they
    // swap in place instead.
    function goToPage(next: number, scrollFirst: boolean) {
      if (paging || next < 0 || next > pageCount - 1 || next === page) return;
      page = next;
      if (scrollFirst) {
        paging = true;
        scrollToSectionTop().then(() => {
          renderPage();
          paging = false;
        });
      } else {
        renderPage();
      }
    }

    wsPrevBtns.forEach(b => b.addEventListener('click', () => goToPage(page - 1, mobileQuery.matches)));
    wsNextBtns.forEach(b => b.addEventListener('click', () => goToPage(page + 1, mobileQuery.matches)));
  }
</script>
