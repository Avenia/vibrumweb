---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import HeroShow from '../components/HeroShow.astro';
import GuitarStrip from '../components/GuitarStrip.astro';
import PageLogoBg from '../components/PageLogoBg.astro';
import WorkshopStoryCard from '../components/WorkshopStoryCard.astro';
import BenchLetter from '../components/BenchLetter.astro';

const stories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = stories[0];
const workshopStories = stories.slice(1);

const WORKSHOP_PAGE_SIZE = 6;

const guitars = (await getCollection('guitars'))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 6);
---

<PageLayout
  title="Vibrum | Handcrafted guitars"
  description="Handcrafted guitars made by Vibrum, where traditional craftsmanship meets design. We are dedicated to creating unique, high-quality instruments that inspire musicians worldwide."
>
  <PageLogoBg reveal />

  <HeroShow />

  {featured && (
    <section class="bench-feature">
      <img class="bench-feature-img" src={featured.data.coverImage} alt="" loading="lazy" />
      <div class="bench-feature-shade" aria-hidden="true"></div>
      <div class="bench-feature-inner container">
        <p class="eyebrow">From the bench</p>
        <h2 class="bench-feature-title">
          <a href={`/stories/${featured.slug}`}>{featured.data.title}</a>
        </h2>
        <p class="bench-feature-excerpt">{featured.data.excerpt}</p>
        <a class="bench-feature-link" href={`/stories/${featured.slug}`}>Read the story →</a>
      </div>
    </section>
  )}

  {(workshopStories.length > 0 || stories.length === 0) && (
    <section class="workshop-band">
      <img
        class="workshop-band-img"
        src="/images/guitars/driftwood-om/photo-15.png"
        alt=""
        loading="lazy"
      />
      <div class="workshop-band-shade" aria-hidden="true"></div>
      <div class="container section workshop-section workshop-band-inner">
        <div class="section-header">
          <h2 class="section-heading">More from the workshop</h2>
          {workshopStories.length > WORKSHOP_PAGE_SIZE && (
            <div class="workshop-nav">
              <button class="workshop-arrow" id="ws-prev" aria-label="Previous stories" disabled>&#8592;</button>
              <span class="workshop-page" id="ws-page" aria-live="polite">
                1 / {Math.ceil(workshopStories.length / WORKSHOP_PAGE_SIZE)}
              </span>
              <button class="workshop-arrow" id="ws-next" aria-label="More stories">&#8594;</button>
            </div>
          )}
        </div>

        {workshopStories.length > 0 ? (
          <div class="workshop-grid" id="workshop-grid" data-page-size={WORKSHOP_PAGE_SIZE}>
            {workshopStories.map((story, i) => (
              <div class="story-reveal" data-ws-index={i} hidden={i >= WORKSHOP_PAGE_SIZE}>
                <WorkshopStoryCard
                  title={story.data.title}
                  slug={story.slug}
                  date={story.data.date}
                  coverImage={story.data.coverImage}
                  excerpt={story.data.excerpt}
                  tags={story.data.tags}
                />
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>Stories coming soon. Check back after the first build.</p>
            <a href="/gallery" class="empty-cta">Browse the gallery →</a>
          </div>
        )}
      </div>
    </section>
  )}

  {guitars.length > 0 && (
    <section class="guitar-band">
      <img
        class="guitar-band-img"
        src="/images/guitars/pyrocaster/photo-19.png"
        alt=""
        loading="lazy"
      />
      <div class="guitar-band-shade" aria-hidden="true"></div>
      <div class="guitar-band-inner container">
        <div class="section-header">
          <h2 class="section-heading">Recent guitars</h2>
        </div>

        <GuitarStrip guitars={guitars} />
      </div>
    </section>
  )}

  <BenchLetter />
</PageLayout>

<style>
  .container {
    position: relative;
    z-index: 1;
  }

  /* =========================================
     Section titles — same style as the
     contact page's .eyebrow
     ========================================= */
  .eyebrow,
  .section-heading {
    /* Explicit family so the h2 titles don't pick up the global heading serif. */
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 18px;
  }

  /* =========================================
     Section header — heading + optional link
     over a hairline rule
     ========================================= */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm);
    border-bottom: 1px solid rgba(255, 245, 220, 0.14);
    padding-bottom: 16px;
    margin-bottom: 40px;
  }

  .section-heading {
    margin: 0; /* the .section-header row handles the spacing */
  }

  /* =========================================
     From the bench — featured story banner
     ========================================= */
  .bench-feature {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 480px;
    overflow: hidden;
    background: var(--color-bg);
  }

  .bench-feature-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .bench-feature-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(10, 9, 6, 0.94) 0%,
      rgba(10, 9, 6, 0.62) 55%,
      rgba(10, 9, 6, 0.35) 100%
    );
  }

  /* Copy spans the full width on small screens, so shade the whole image. */
  @media (max-width: 639px) {
    .bench-feature-shade {
      background: linear-gradient(
        to right,
        rgba(10, 9, 6, 0.92) 0%,
        rgba(10, 9, 6, 0.72) 100%
      );
    }
  }

  .bench-feature-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-lg);
  }

  .bench-feature-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.15;
    color: #EDE7D4;
    margin: 0 0 16px;
    max-width: 640px;
  }

  .bench-feature-title a {
    transition: color var(--transition);
  }

  .bench-feature-title a:hover {
    color: var(--color-accent);
  }

  .bench-feature-excerpt {
    font-size: 1.02rem;
    line-height: 1.7;
    color: rgba(255, 245, 220, 0.62);
    max-width: 560px;
    margin: 0 0 28px;
  }

  .bench-feature-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #EDE7D4;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 6px;
    transition: color var(--transition);
  }

  .bench-feature-link:hover {
    color: var(--color-accent);
  }

  /* =========================================
     More from the workshop
     ========================================= */
  .workshop-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .workshop-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .workshop-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      row-gap: var(--space-lg);
    }
  }

  @media (max-width: 639px) {
    .workshop-section .section-header {
      margin-bottom: var(--space-md);
    }
  }

  /* Scroll-triggered card reveals */
  .story-reveal {
    opacity: 0;
    transform: translateY(28px); /* default: waiting below, enter from bottom */
    transition: opacity 0.55s ease-out, transform 0.55s ease-out;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .story-reveal.from-top {
    transform: translateY(-28px); /* waiting above, enter from top */
  }

  .story-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .story-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .empty-state {
    color: var(--color-text-muted);
    padding: var(--space-lg) 0;
  }

  .empty-cta {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-accent);
    font-size: 0.9rem;
    transition: opacity var(--transition);
  }

  .empty-cta:hover {
    opacity: 0.7;
  }

  /* =========================================
     More from the workshop — full-bleed band
     with paged story grid
     ========================================= */
  .workshop-band {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .workshop-band-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the mahogany body (lower half of the source photo) in frame. */
    object-position: center 62%;
  }

  /* Same heavy edge-melting veil as the guitars band below. */
  .workshop-band-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 6, 0.97) 0%,
      rgba(10, 9, 6, 0.9) 32%,
      rgba(10, 9, 6, 0.9) 68%,
      rgba(10, 9, 6, 0.97) 100%
    );
  }

  .workshop-band-inner {
    z-index: 1;
  }

  .workshop-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .workshop-page {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: rgba(255, 245, 220, 0.45);
    white-space: nowrap;
  }

  .workshop-arrow {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(10, 9, 6, 0.6);
    border: 1px solid var(--color-border);
    color: var(--color-text-bold);
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
    transition: background var(--transition), border-color var(--transition), opacity var(--transition);
  }

  .workshop-arrow:hover:not(:disabled) {
    background: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .workshop-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* =========================================
     Recent guitars — full-bleed strip band
     ========================================= */
  .guitar-band {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    /* Bottom hairline comes from .bench-letter's border-top right below,
       so the two bands share a single rule instead of doubling up. */
    background: var(--color-bg);
  }

  .guitar-band-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* Heavy veil, deepening toward the edges so the band melts
     into the page background above and the letter band below. */
  .guitar-band-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 6, 0.97) 0%,
      rgba(10, 9, 6, 0.88) 32%,
      rgba(10, 9, 6, 0.88) 68%,
      rgba(10, 9, 6, 0.97) 100%
    );
  }

  .guitar-band-inner {
    z-index: 1;
    padding-block: var(--space-md);
  }

</style>

<script>
  // --- Reveal the fixed logo watermark once the hero is scrolled past ---
  const logoBg = document.querySelector('.page-logo-bg') as HTMLElement | null;
  const hero = document.getElementById('hero');
  if (logoBg && hero) {
    new IntersectionObserver(
      ([entry]) => logoBg.classList.toggle('is-visible', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);
  }

  // --- Scroll-triggered story card reveals ---
  const cards = document.querySelectorAll<HTMLElement>('.story-reveal');

  // Stagger by column so each row cascades left→right on the 3-column grid.
  cards.forEach((card, i) => {
    card.style.setProperty('--reveal-delay', `${(i % 3) * 120}ms`);
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        const el = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          el.classList.add('is-visible');
          el.classList.remove('from-top');
        } else {
          el.classList.remove('is-visible');
          // Prep slide direction for next entry:
          // top < 0 → card exited above → next entry comes from top
          // top > 0 → card exited below → next entry comes from bottom (default)
          if (entry.boundingClientRect.top < 0) {
            el.classList.add('from-top');
          } else {
            el.classList.remove('from-top');
          }
        }
      });
    },
    { threshold: 0.08 }
  );

  cards.forEach(card => observer.observe(card));

  // --- Workshop story pagination (6 per page) ---
  const wsGrid = document.getElementById('workshop-grid');
  const wsPrev = document.getElementById('ws-prev') as HTMLButtonElement | null;
  const wsNext = document.getElementById('ws-next') as HTMLButtonElement | null;
  const wsPage = document.getElementById('ws-page');

  if (wsGrid && wsPrev && wsNext && wsPage) {
    const items = Array.from(wsGrid.querySelectorAll<HTMLElement>('[data-ws-index]'));
    const pageSize = Number(wsGrid.dataset.pageSize) || 6;
    const pageCount = Math.ceil(items.length / pageSize);
    let page = 0;

    function renderPage() {
      items.forEach((item, i) => {
        const visible = i >= page * pageSize && i < (page + 1) * pageSize;
        item.hidden = !visible;
        // Newly shown cards should be readable immediately, not wait for a
        // scroll event to re-trigger the reveal observer.
        if (visible) item.classList.add('is-visible');
      });
      wsPrev!.disabled = page === 0;
      wsNext!.disabled = page === pageCount - 1;
      wsPage!.textContent = `${page + 1} / ${pageCount}`;
    }

    wsPrev.addEventListener('click', () => { if (page > 0) { page--; renderPage(); } });
    wsNext.addEventListener('click', () => { if (page < pageCount - 1) { page++; renderPage(); } });
  }
</script>
