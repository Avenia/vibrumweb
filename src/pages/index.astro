---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import Slideshow from '../components/Slideshow.astro';
import GuitarStrip from '../components/GuitarStrip.astro';
import PageLogoBg from '../components/PageLogoBg.astro';

const stories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slideEntries = await getCollection('slides');
const slideGuitarSlugs = new Set(
  slideEntries.flatMap(s => {
    const m = s.data.button?.url?.match(/^\/gallery#guitar-(.+)$/);
    return m ? [m[1]] : [];
  })
);

const allGuitars = (await getCollection('guitars')).sort((a, b) => b.data.year - a.data.year);
const top6 = allGuitars.slice(0, 6);
const top6Slugs = new Set(top6.map(g => g.slug));
const slideExtras = allGuitars.filter(g => slideGuitarSlugs.has(g.slug) && !top6Slugs.has(g.slug));
const guitars = [...top6, ...slideExtras];
---

<PageLayout
  title="Vibrum | Handcrafted guitars"
  description="Handcrafted guitars made by Vibrum, where traditional craftsmanship meets design. We are dedicated to creating unique, high-quality instruments that inspire musicians worldwide."
>
  <PageLogoBg reveal />

  <div class="container section">
    <Slideshow />

    <header class="home-header">
      <p class="home-eyebrow">latest guitars</p>
    </header>

    {guitars.length > 0 && <GuitarStrip guitars={guitars} />}

    <header class="home-header">
      <p class="home-eyebrow">latest stories</p>
    </header>

    <div class="stories-section">
      {stories.length > 0 ? (
        <div class="stories-grid">
          {stories.map(story => (
            <div class="story-reveal">
              <StoryCard
                title={story.data.title}
                slug={story.slug}
                date={story.data.date}
                coverImage={story.data.coverImage}
                excerpt={story.data.excerpt}
                tags={story.data.tags}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Stories coming soon. Check back after the first build.</p>
          <a href="/gallery" class="empty-cta">Browse the gallery →</a>
        </div>
      )}
    </div>
  </div>
</PageLayout>

<style>
  .container {
    position: relative;
    z-index: 1;
  }

  /* Ghost mark */
  .stories-section {
    position: relative;
    overflow: hidden;
  }

  .ghost-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 480px;
    height: 480px;
    pointer-events: none;
    z-index: 0;
  }

  .ghost-mark svg {
    width: 100%;
    height: 100%;
    fill: var(--color-accent);
    opacity: 0.05;
    filter: blur(1px);
    animation: ghost-rotate 120s linear infinite;
  }

  @keyframes ghost-rotate {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .stories-grid, .empty-state {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .ghost-mark svg { animation: none; }
  }

  /* Page content */
  .home-header {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .home-eyebrow {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);

    /* Center with decorative lines */
    display: flex;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
    white-space: nowrap;

    /* Shimmer sweep across text */
    background: linear-gradient(
      90deg,
      #c9a84c 30%,
      #fff3c4 47%,
      #fffbe8 50%,
      #fff3c4 53%,
      #c9a84c 70%
    );
    background-size: 400% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: eyebrow-gloss 6s ease-in-out infinite alternate;
  }

  .home-eyebrow::before,
  .home-eyebrow::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #c9a84c 30%,
      #fff3c4 47%,
      #fffbe8 50%,
      #fff3c4 53%,
      #c9a84c 70%,
      transparent 100%
    );
    background-size: 400% auto;
    animation: eyebrow-gloss 6s ease-in-out infinite alternate;
    opacity: 0.6;
  }

  @keyframes eyebrow-gloss {
    0%   { background-position: 120% center; }
    100% { background-position: -20% center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-eyebrow,
    .home-eyebrow::before,
    .home-eyebrow::after {
      animation: none;
      background-position: 0% center;
    }
  }

  .home-title {
    margin-bottom: var(--space-xs);
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    padding-top: var(--space-xs);
  }

  @media (max-width: 639px) {
    .home-eyebrow {
      gap: 1.5rem;
      font-size: 0.70rem;
    }

    .stories-grid {
      padding-inline: var(--space-sm);
    }

    .home-header {
      padding-inline: calc(var(--space-sm) + 0.5rem);
      margin-top: 3rem;
      margin-bottom: var(--space-sm);
    }
  }

  @media (min-width: 640px) {
    .stories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stories-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }

  }

  /* Scroll-triggered card reveals */
  .story-reveal {
    opacity: 0;
    transform: translateY(28px); /* default: waiting below, enter from bottom */
    transition: opacity 0.55s ease-out, transform 0.55s ease-out;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .story-reveal.from-top {
    transform: translateY(-28px); /* waiting above, enter from top */
  }

  .story-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .story-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .empty-state {
    color: var(--color-text-muted);
    padding: var(--space-lg) 0;
  }

  .empty-cta {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-accent);
    font-size: 0.9rem;
    transition: opacity var(--transition);
  }

  .empty-cta:hover {
    opacity: 0.7;
  }
</style>

<script>
  const logoBg = document.querySelector('.page-logo-bg') as HTMLElement | null;
  const slideshow = document.getElementById('slideshow');
  if (logoBg && slideshow) {
    new IntersectionObserver(
      ([entry]) => logoBg.classList.toggle('is-visible', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(slideshow);
  }

  const cards = document.querySelectorAll<HTMLElement>('.story-reveal');

  // Even-index cards appear immediately; odd-index cards lag 140ms.
  // On the 2-column grid this gives a left→right cascade per row.
  cards.forEach((card, i) => {
    card.style.setProperty('--reveal-delay', i % 2 === 0 ? '0ms' : '140ms');
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        const el = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          el.classList.add('is-visible');
          el.classList.remove('from-top');
        } else {
          el.classList.remove('is-visible');
          // Prep slide direction for next entry:
          // top < 0 → card exited above → next entry comes from top
          // top > 0 → card exited below → next entry comes from bottom (default)
          if (entry.boundingClientRect.top < 0) {
            el.classList.add('from-top');
          } else {
            el.classList.remove('from-top');
          }
        }
      });
    },
    { threshold: 0.08 }
  );

  cards.forEach(card => observer.observe(card));
</script>

