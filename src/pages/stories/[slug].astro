---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import GuitarModal from '../../components/GuitarModal.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map(story => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await story.render();

const guitar = story.data.guitar ? await getEntry('guitars', story.data.guitar) : null;
const guitarRendered = guitar ? await guitar.render() : null;
const GuitarContent = guitarRendered?.Content;
const guitarImages = guitar ? [guitar.data.coverImage, ...(guitar.data.images ?? [])] : [];

// Photos placed in the story body (markdown ![alt](src)). On desktop they render
// as the right-hand photo column; on phones they stay in the text flow. They also
// merge into the modal's image list, so a clicked photo opens the modal on itself.
const inlinePhotos = [...story.body.matchAll(/!\[([^\]]*)\]\(\s*([^)\s]+)/g)]
  .map(m => ({ alt: m[1], src: m[2] }));
const modalImages = [
  ...guitarImages,
  ...inlinePhotos.map(p => p.src).filter(src => !guitarImages.includes(src)),
];

const typeLabels: Record<string, string> = {
  electric: 'Electric', acoustic: 'Acoustic', bass: 'Bass', classical: 'Classical',
};
const sectionLabels: Record<string, string> = {
  materials: 'Materials', technical: 'Technical', hardware: 'Hardware',
};
const fieldLabels: Record<string, string> = {
  top: 'Top', base: 'Base', neck: 'Neck', fretboard: 'Fretboard',
  headstock_top: 'Headstock Top', fretmarkers: 'Fretmarkers',
  nut: 'Nut', frets: 'Frets', details: 'Details', finish: 'Finish',
  body_shape: 'Body Shape', scale: 'Scale Length', nut_width: 'Nut Width',
  radius: 'Fingerboard Radius', neck_profile: 'Neck Profile', weight: 'Weight',
  pickups: 'Pickups', bridge: 'Bridge', tailpiece: 'Tailpiece',
  pots: 'Pots', controls: 'Controls', switch: 'Switch',
  tuners: 'Tuners', neck_plate: 'Neck Plate', strap_locks: 'Strap Locks',
  output: 'Output Jack',
};

const formattedDate = story.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Card-style mono meta: "SEPTEMBER 2025 · BUILD DIARY"
const metaDate = story.data.date
  .toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  .toUpperCase();
const categoryLabel = story.data.category.replace(/-/g, ' ').toUpperCase();
---

<PageLayout
  title={`${story.data.title} — Vibrum Guitars`}
  description={story.data.excerpt}
  ogImage={story.data.coverImage}
  ogType="article"
>
  <div class="story-detail">
    <!-- Hero — full-bleed band, same treatment as the homepage banners -->
    <section class="story-hero">
      <img src={story.data.coverImage} alt="" class="story-hero-img" />
      <div class="story-hero-shade" aria-hidden="true"></div>
      <div class="story-hero-inner container">
        <p class="story-meta">
          <time datetime={story.data.date.toISOString()} title={formattedDate}>{metaDate}</time>
          <span> · {categoryLabel}</span>
        </p>
        <h1 class="story-title">{story.data.title}</h1>
      </div>
    </section>

    <div class="container">
      <div class="story-content-wrap">
        <article class="story-prose prose">
          <Content />
        </article>

        {(guitar || inlinePhotos.length > 0) && (
          <aside class="story-aside">
            {guitar && (
              <div class="story-guitar-link">
                <p class="story-guitar-label">Featured instrument</p>
                <button type="button" class="story-guitar-btn" id="story-guitar-trigger">
                  View all photos
                </button>
              </div>
            )}
            {inlinePhotos.length > 0 && (
              <div class="story-aside-photos">
                {inlinePhotos.map(p => (
                  <img class="story-side-photo" src={p.src} alt={p.alt} loading="lazy" decoding="async" />
                ))}
              </div>
            )}
          </aside>
        )}
      </div>

      <a href="/#stories" class="back-link">All stories</a>
    </div>
  </div>

  {!guitar && (
    <!-- Minimal fullscreen viewer for story photos when no guitar is linked -->
    <div class="story-lightbox" id="story-lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightbox-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button class="lightbox-nav lightbox-nav--prev" id="lightbox-prev" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <button class="lightbox-nav lightbox-nav--next" id="lightbox-next" aria-label="Next photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <div class="lightbox-counter" id="lightbox-counter"></div>
    </div>
  )}

  {guitar && GuitarContent && (
    <div id="story-guitar-wrapper" hidden>
      <template class="modal-data" data-slug={guitar.slug}>
        <div
          data-title={guitar.data.title}
          data-year={guitar.data.year}
          data-type={typeLabels[guitar.data.type] ?? guitar.data.type}
          data-status={guitar.data.status}
          data-images={JSON.stringify(modalImages)}
        >
          <div class="modal-specs">
            {guitar.data.specs && Object.entries(guitar.data.specs).map(([sectionKey, fields]) => {
              if (!fields) return null;
              const rows = Object.entries(fields).filter(([, v]) => v !== undefined && v !== null);
              if (rows.length === 0) return null;
              return (
                <div class="spec-section">
                  <h4 class="spec-section-title">{sectionLabels[sectionKey] ?? sectionKey}</h4>
                  <dl class="spec-list">
                    {rows.map(([key, value]) => (
                      <div class="spec-row">
                        <dt class="spec-key">{fieldLabels[key] ?? key}</dt>
                        <dd class="spec-val">{String(value)}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              );
            })}
          </div>
          <div class="modal-prose prose">
            <GuitarContent />
          </div>
        </div>
      </template>
    </div>
  )}

  <GuitarModal />
</PageLayout>

<script>
  const trigger = document.getElementById('story-guitar-trigger');
  const wrapper = document.getElementById('story-guitar-wrapper');
  if (trigger && wrapper) {
    trigger.addEventListener('click', () => window.openGuitarModal(wrapper));
  }

  // --- Story photos: in-text copies (mobile) + right-column copies (desktop) ---
  const photos = Array.from(
    document.querySelectorAll<HTMLImageElement>('.story-prose img.story-float')
  );
  const allPhotoEls = [
    ...photos,
    ...document.querySelectorAll<HTMLImageElement>('.story-side-photo'),
  ];

  if (wrapper && allPhotoEls.length > 0) {
    // Guitar linked: photos open the guitar modal on themselves.
    const data = (wrapper.querySelector('template.modal-data') as HTMLTemplateElement)
      .content.querySelector<HTMLElement>('[data-title]')!;
    const modalImages: string[] = JSON.parse(data.dataset.images!);
    allPhotoEls.forEach(img => {
      img.classList.add('story-float--clickable');
      img.addEventListener('click', () => {
        const idx = modalImages.indexOf(img.getAttribute('src') ?? '');
        window.openGuitarModal(wrapper, Math.max(idx, 0));
      });
    });
  }

  // --- Lightbox (stories without a featured guitar) ---
  const lightbox = document.getElementById('story-lightbox');
  if (lightbox && photos.length > 0) {
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbCounter = document.getElementById('lightbox-counter')!;
    const lbPrev = document.getElementById('lightbox-prev')!;
    const lbNext = document.getElementById('lightbox-next')!;
    const lbClose = document.getElementById('lightbox-close')!;
    let current = 0;

    function show(i: number) {
      current = (i + photos.length) % photos.length;
      lbImg.src = photos[current].src;
      lbImg.alt = photos[current].alt;
      lbCounter.textContent = photos.length > 1 ? `${current + 1} / ${photos.length}` : '';
      lbPrev.style.display = photos.length > 1 ? '' : 'none';
      lbNext.style.display = photos.length > 1 ? '' : 'none';
    }

    function open(i: number) {
      show(i);
      lightbox!.classList.add('story-lightbox--open');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.classList.remove('story-lightbox--open');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    allPhotoEls.forEach(img => {
      img.classList.add('story-float--clickable');
      img.addEventListener('click', () => {
        const idx = photos.findIndex(p => p.getAttribute('src') === img.getAttribute('src'));
        open(Math.max(idx, 0));
      });
    });

    lbPrev.addEventListener('click', () => show(current - 1));
    lbNext.addEventListener('click', () => show(current + 1));
    lbClose.addEventListener('click', close);
    lightbox.addEventListener('click', e => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', e => {
      if (!lightbox!.classList.contains('story-lightbox--open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Swipe between photos on touch screens
    let touchX = 0;
    lightbox.addEventListener('touchstart', e => {
      touchX = (e as TouchEvent).touches[0].clientX;
    }, { passive: true });
    lightbox.addEventListener('touchend', e => {
      const dx = (e as TouchEvent).changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) show(dx < 0 ? current + 1 : current - 1);
    }, { passive: true });
  }
</script>

<style>
  .story-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    max-height: 60vh;
    overflow: hidden;
    background-color: var(--color-bg-raised);
  }

  .story-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  /* Cover photos are light studio shots — heavy on the left where the
     title sits, deeper at the bottom so the copy always reads. */
  .story-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 9, 6, 0.92), transparent 55%),
      linear-gradient(
        to right,
        rgba(10, 9, 6, 0.9) 0%,
        rgba(10, 9, 6, 0.68) 55%,
        rgba(10, 9, 6, 0.5) 100%
      );
  }

  .story-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-lg);
  }

  .story-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  .story-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.15;
    color: #EDE7D4;
    margin: 0;
    max-width: 760px;
  }

  .story-content-wrap {
    padding: var(--space-md) 0 var(--space-lg);
  }

  /* Desktop: two columns — text left, photo column right */
  @media (min-width: 768px) {
    .story-content-wrap {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: var(--space-lg);
      align-items: start;
    }
  }

  .story-prose {
    font-size: 1.05rem;
    line-height: 1.85;
    display: flow-root;
  }

  /* Mobile: aside stacks after the article — button only, photos stay in-text */
  .story-aside {
    margin-top: var(--space-md);
  }

  .story-aside-photos {
    display: none;
  }

  @media (min-width: 768px) {
    /* Photos on top, "Featured instrument" + button underneath */
    .story-aside {
      margin-top: 0;
      display: flex;
      flex-direction: column;
    }

    .story-aside-photos {
      display: flex;
      flex-direction: column;
      gap: 14px;
      order: 1;
    }

    .story-guitar-link {
      order: 2;
    }

    .story-aside:has(.story-aside-photos) .story-guitar-link {
      margin-top: var(--space-md);
    }
  }

  .story-side-photo {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
  }

  :global(.story-side-photo.story-float--clickable) {
    cursor: pointer;
    transition: border-color var(--transition), transform var(--transition);
  }

  :global(.story-side-photo.story-float--clickable:hover) {
    border-color: rgba(201, 168, 76, 0.45);
    transform: scale(1.015);
  }

  /* Same recipe as the About page section labels (The Story / The Team / The Work) */
  .story-guitar-label {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  /* Same recipe as the newsletter Subscribe button, full radius (standalone) */
  .story-guitar-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0a0906;
    background: var(--color-accent);
    border: none;
    border-radius: var(--radius-sm);
    padding: 14px 24px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity var(--transition);
  }

  .story-guitar-btn:hover {
    opacity: 0.88;
  }

  /* ---- Lightbox (no-guitar stories) ---- */
  .story-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background-color: rgba(10, 9, 6, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .story-lightbox--open {
    display: flex;
    animation: lightboxFadeIn 180ms ease;
  }

  @keyframes lightboxFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .lightbox-img {
    max-width: 92vw;
    max-height: 86vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    z-index: 1;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 9, 6, 0.55);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(201, 168, 76, 0.15);
    border-color: rgba(201, 168, 76, 0.5);
  }

  .lightbox-close svg,
  .lightbox-nav svg { width: 18px; height: 18px; }

  .lightbox-close { top: 16px; right: 16px; }
  .lightbox-nav { top: 50%; transform: translateY(-50%); }
  .lightbox-nav--prev { left: 16px; }
  .lightbox-nav--next { right: 16px; }

  .lightbox-counter {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #EDE7D4;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 6px;
    margin-bottom: var(--space-lg);
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-accent);
  }
</style>
