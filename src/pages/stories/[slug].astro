---
import { getCollection, getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import GuitarModal from '../../components/GuitarModal.astro';
import GuitarModalData from '../../components/GuitarModalData.astro';
import { WEBSITE_ID, absoluteUrl, guitarModalHash, guitarUrl, publisherRef } from '../../lib/seo';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map(story => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);

// A story can feature one guitar or several (the schema normalises `guitar`
// to a list). Ids that match no entry are dropped; Astro warns about them.
// The modal shows each guitar's own gallery only. Photos placed in the story
// body (markdown ![alt](src)) stay in the text flow and open in the lightbox.
const featured = (
  await Promise.all(story.data.guitar.map(id => getEntry('guitars', id)))
).filter((g): g is NonNullable<typeof g> => g != null);

const formattedDate = story.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Card-style mono meta: "SEPTEMBER 2025 · BUILD DIARY"
const metaDate = story.data.date
  .toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  .toUpperCase();
const categoryName = story.data.category.replace(/-/g, ' ');
const categoryLabel = categoryName.toUpperCase();

// The story as a schema.org BlogPosting. Photos are the cover plus every
// markdown image in the body, in order; the featured guitars are linked as
// the Products the post is about (same @id as on the gallery page).
const bodyPhotos = [...(story.body ?? '').matchAll(/!\[[^\]]*\]\(([^)\s]+)/g)].map(m => m[1]);
const photos = [...new Set([story.data.coverImage, ...bodyPhotos])];
const isoDate = story.data.date.toISOString().slice(0, 10);
const schema = {
  '@type': 'BlogPosting',
  headline: story.data.title,
  description: story.data.excerpt,
  image: photos.map(absoluteUrl),
  datePublished: isoDate,
  dateModified: isoDate,
  author: publisherRef,
  publisher: publisherRef,
  mainEntityOfPage: { '@type': 'WebPage', '@id': absoluteUrl(`/stories/${story.id}/`) },
  isPartOf: { '@id': WEBSITE_ID },
  articleSection: categoryName.replace(/^\w/, c => c.toUpperCase()),
  inLanguage: 'en',
  ...(featured.length > 0 && {
    about: featured.map(g => ({
      '@type': 'Product',
      '@id': guitarUrl(g.id),
      name: g.data.title,
      url: guitarUrl(g.id),
    })),
  }),
};
---

<PageLayout
  title={`Vibrum | ${story.data.title}`}
  description={story.data.excerpt}
  ogImage={story.data.coverImage}
  ogImageAlt={story.data.title}
  ogType="article"
  publishedTime={story.data.date}
  schema={schema}
>
  <div class="story-detail">
    <!-- Hero — full-bleed band, same treatment as the homepage banners -->
    <section class="story-hero band-stage">
      <img src={story.data.coverImage} alt="" class="story-hero-img" />
      <div class="story-hero-shade" aria-hidden="true"></div>
      <div class="story-hero-inner container container--reading">
        <p class="story-meta">
          <time datetime={story.data.date.toISOString()} title={formattedDate}>{metaDate}</time>
          <span> · {categoryLabel}</span>
        </p>
        <h1 class="story-title">{story.data.title}</h1>
      </div>
    </section>

    <div class="container container--reading">
      <div class="story-content-wrap">
        <article class="story-prose prose">
          <Content />
        </article>

        {featured.length > 0 && (
          <aside class="story-aside">
            <div class="story-guitar-link">
              <p class="story-guitar-label">
                {featured.length > 1 ? 'Featured instruments' : 'Featured instrument'}
              </p>
              <!-- Links to the quick view (#guitar-<id>): a plain click opens the
                   modal here, a middle-click or Cmd/Ctrl-click opens a new tab on
                   this story with the modal already open -->
              <div class="story-guitar-btns">
                {featured.map(g => (
                  <a href={guitarModalHash(g.id)} class="story-guitar-btn" data-guitar={g.id}>
                    View {g.data.title}
                  </a>
                ))}
              </div>
            </div>
          </aside>
        )}
      </div>

      <a href="/#stories" class="back-link">All stories</a>
    </div>
  </div>

  <!-- Fullscreen viewer for the photos in the story body -->
  <div class="story-lightbox" id="story-lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="lightbox-nav lightbox-nav--prev" id="lightbox-prev" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <button class="lightbox-nav lightbox-nav--next" id="lightbox-next" aria-label="Next photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lightbox-counter" id="lightbox-counter"></div>
  </div>

  {featured.map(guitar => (
    <div class="story-guitar-wrapper" data-guitar={guitar.id} hidden>
      <GuitarModalData guitar={guitar} />
    </div>
  ))}

  <GuitarModal />
</PageLayout>

<script>
  import { isPlainClick } from '../../lib/plainClick';

  // Each featured-guitar link opens the modal on its own hidden wrapper on a
  // plain click; modified and middle clicks are left to the browser, which
  // opens this story in a new tab where the modal opens from the hash on load.
  document.querySelectorAll<HTMLAnchorElement>('.story-guitar-btn').forEach(btn => {
    const id = btn.dataset.guitar ?? '';
    const wrapper = document.querySelector<HTMLElement>(
      `.story-guitar-wrapper[data-guitar="${CSS.escape(id)}"]`
    );
    if (!wrapper) return;
    btn.addEventListener('click', e => {
      if (!isPlainClick(e)) return;
      e.preventDefault();
      window.openGuitarModal(wrapper, 0, btn);
    });
  });

  // --- Lightbox for the photos in the story body ---
  const photos = Array.from(
    document.querySelectorAll<HTMLImageElement>('.story-prose img.story-float')
  );
  const lightbox = document.getElementById('story-lightbox');
  if (lightbox && photos.length > 0) {
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbCounter = document.getElementById('lightbox-counter')!;
    const lbPrev = document.getElementById('lightbox-prev')!;
    const lbNext = document.getElementById('lightbox-next')!;
    const lbClose = document.getElementById('lightbox-close')!;
    const box: HTMLElement = lightbox;
    let current = 0;
    // Opening pushes a "#photo-N" history entry, so the phone's back button
    // (and swipe-back) closes the photo instead of leaving the story. Same
    // scheme as the guitar modal's "#guitar-<slug>-pN".
    let pushedHash = false;
    const photoHash = () => `#photo-${current + 1}`;
    const isOpen = () => box.classList.contains('story-lightbox--open');

    function show(i: number) {
      current = (i + photos.length) % photos.length;
      lbImg.src = photos[current].src;
      lbImg.alt = photos[current].alt;
      lbCounter.textContent = photos.length > 1 ? `${current + 1} / ${photos.length}` : '';
      lbPrev.style.display = photos.length > 1 ? '' : 'none';
      lbNext.style.display = photos.length > 1 ? '' : 'none';
      // Stepping between photos updates the entry in place, never adds one.
      if (location.hash.startsWith('#photo-') && location.hash !== photoHash()) {
        history.replaceState(null, '', photoHash());
      }
    }

    function open(i: number) {
      show(i);
      box.classList.add('story-lightbox--open');
      box.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (location.hash === photoHash()) {
        // Deep-link load or Forward: the entry is already there.
        pushedHash = false;
      } else {
        history.pushState(null, '', photoHash());
        pushedHash = true;
      }
    }

    function hide() {
      box.classList.remove('story-lightbox--open');
      box.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function close() {
      if (pushedHash) {
        // We added the hash entry on open; pop it so Back then leaves the
        // page rather than returning to a stale photo entry. popstate hides.
        pushedHash = false;
        history.back();
        return;
      }
      hide();
      if (location.hash.startsWith('#photo-')) {
        history.replaceState(null, '', location.pathname + location.search);
      }
    }

    // "#photo-N" in the URL (deep link, or Forward after a Back) opens photo N
    function openFromHash() {
      const m = location.hash.match(/^#photo-(\d+)$/);
      const n = m ? parseInt(m[1], 10) : 0;
      if (n >= 1 && n <= photos.length) {
        open(n - 1);
        return true;
      }
      return false;
    }

    window.addEventListener('popstate', () => {
      pushedHash = false;
      if (!openFromHash() && isOpen()) hide();
    });

    openFromHash();

    photos.forEach((img, i) => {
      img.classList.add('story-float--clickable');
      img.addEventListener('click', () => open(i));
    });

    lbPrev.addEventListener('click', () => show(current - 1));
    lbNext.addEventListener('click', () => show(current + 1));
    lbClose.addEventListener('click', close);
    lightbox.addEventListener('click', e => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', e => {
      if (!isOpen()) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Touch, same as the gallery modal: two fingers pinch-zoom the photo and
    // it springs back on release; one finger swipes to the next photo only
    // when the movement is mostly horizontal. A pinch locks swiping until the
    // next fresh touch, so the first finger of a pinch is never read as the
    // start of a swipe and a zoom cannot change the photo by accident.
    let swipeStartX = 0;
    let swipeStartY = 0;
    let swipeLocked = false;
    let isPinching = false;
    let pinchStartDist = 0;

    const pinchDist = (te: TouchEvent) =>
      Math.hypot(te.touches[0].clientX - te.touches[1].clientX, te.touches[0].clientY - te.touches[1].clientY);

    box.addEventListener('touchstart', e => {
      const te = e as TouchEvent;
      if (te.touches.length >= 2) {
        swipeLocked = true;
        isPinching = true;
        pinchStartDist = pinchDist(te);
        const rect = lbImg.getBoundingClientRect();
        const midX = (te.touches[0].clientX + te.touches[1].clientX) / 2;
        const midY = (te.touches[0].clientY + te.touches[1].clientY) / 2;
        lbImg.style.transformOrigin = `${((midX - rect.left) / rect.width) * 100}% ${((midY - rect.top) / rect.height) * 100}%`;
        te.preventDefault();
        return;
      }
      swipeStartX = te.touches[0].clientX;
      swipeStartY = te.touches[0].clientY;
      swipeLocked = false;
      isPinching = false;
    }, { passive: false });

    box.addEventListener('touchmove', e => {
      const te = e as TouchEvent;
      if (isPinching && te.touches.length >= 2) {
        const scale = Math.max(1, Math.min(4, pinchDist(te) / pinchStartDist));
        lbImg.style.transition = 'none';
        lbImg.style.transform = `scale(${scale})`;
        te.preventDefault();
        return;
      }
      if (isPinching) return;
      const t = te.touches[0];
      if (Math.abs(t.clientY - swipeStartY) > Math.abs(t.clientX - swipeStartX)) swipeLocked = true;
    }, { passive: false });

    box.addEventListener('touchend', e => {
      const te = e as TouchEvent;
      if (isPinching) {
        if (te.touches.length < 2) {
          isPinching = false;
          lbImg.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
          lbImg.style.transform = 'scale(1)';
          lbImg.addEventListener('transitionend', () => {
            lbImg.style.transition = '';
            lbImg.style.transform = '';
            lbImg.style.transformOrigin = '';
          }, { once: true });
        }
        return;
      }
      if (swipeLocked) return;
      const t = te.changedTouches[0];
      const dx = t.clientX - swipeStartX;
      const dy = t.clientY - swipeStartY;
      if (Math.abs(dx) < 30 || Math.abs(dy) > Math.abs(dx)) return;
      show(dx < 0 ? current + 1 : current - 1);
    }, { passive: false });
  }
</script>

<style>
  .story-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    max-height: 60vh;
    overflow: hidden;
    background-color: var(--color-bg-raised);
  }

  .story-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  /* Cover photos are light studio shots — heavy on the left where the
     title sits, deeper at the bottom so the copy always reads. */
  .story-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 9, 6, 0.92), transparent 55%),
      linear-gradient(
        to right,
        rgba(10, 9, 6, 0.9) 0%,
        rgba(10, 9, 6, 0.68) 55%,
        rgba(10, 9, 6, 0.5) 100%
      );
  }

  .story-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-lg);
  }

  .story-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  .story-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.15;
    color: #EDE7D4;
    margin: 0;
    max-width: 760px;
  }

  .story-content-wrap {
    padding: var(--space-md) 0 var(--space-lg);
  }

  .story-prose {
    font-size: 1.05rem;
    line-height: 1.85;
    display: flow-root;
  }

  /* "Featured instrument(s)" + buttons: after the article on phones */
  .story-aside {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  /* Desktop: text and photos take three quarters, the featured instrument
     the right quarter behind a thin divider, the same line the gallery draws
     beside its filters. The aside spans the full height of the text so the
     line runs the whole way; the block inside sticks below the fixed nav
     while the text scrolls. Stories without a guitar keep the single column. */
  @media (min-width: 768px) {
    .story-content-wrap:has(> .story-aside) {
      display: grid;
      grid-template-columns: 3fr 1fr;
      gap: var(--space-md);
    }

    .story-aside {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
      padding-left: var(--space-md);
      border-left: 1px solid rgba(201, 168, 76, 0.25);
    }

    .story-guitar-link {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-md));
    }

    /* The quarter column is too narrow for two buttons abreast */
    .story-guitar-btns {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* One button per featured guitar, side by side on phones */
  .story-guitar-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Same recipe as the About page section labels (The Story / The Team / The Work) */
  .story-guitar-label {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  /* Same recipe as the newsletter Subscribe button, full radius (standalone) */
  .story-guitar-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0a0906;
    background: var(--color-accent);
    border: none;
    border-radius: var(--radius-sm);
    padding: 14px 24px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity var(--transition);
  }

  .story-guitar-btn:hover {
    opacity: 0.88;
  }

  /* ---- Lightbox ---- */
  .story-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    /* The script handles pinch zoom and swipes; keep the browser from zooming the page */
    touch-action: none;
    /* Same backlight as the guitar modal: a dark field with a gold glow behind the photo */
    background-color: rgba(10, 9, 6, 0.88);
    background-image: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(201, 168, 76, 0.53) 0%, transparent 70%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .story-lightbox--open {
    display: flex;
    animation: lightboxFadeIn 180ms ease;
  }

  @keyframes lightboxFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .lightbox-img {
    max-width: 92vw;
    max-height: 86vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 48px rgba(10, 9, 6, 0.7);
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    z-index: 1;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 9, 6, 0.55);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(201, 168, 76, 0.15);
    border-color: rgba(201, 168, 76, 0.5);
  }

  .lightbox-close svg,
  .lightbox-nav svg { width: 18px; height: 18px; }

  .lightbox-close { top: 16px; right: 16px; }
  .lightbox-nav { top: 50%; transform: translateY(-50%); }
  .lightbox-nav--prev { left: 16px; }
  .lightbox-nav--next { right: 16px; }

  .lightbox-counter {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #EDE7D4;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 6px;
    margin-bottom: var(--space-lg);
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-accent);
  }
</style>
