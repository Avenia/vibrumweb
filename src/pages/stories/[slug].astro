---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import GuitarModal from '../../components/GuitarModal.astro';
import BenchLetter from '../../components/BenchLetter.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map(story => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await story.render();

const guitar = story.data.guitar ? await getEntry('guitars', story.data.guitar) : null;
const guitarRendered = guitar ? await guitar.render() : null;
const GuitarContent = guitarRendered?.Content;
const guitarImages = guitar ? [guitar.data.coverImage, ...(guitar.data.images ?? [])] : [];

const typeLabels: Record<string, string> = {
  electric: 'Electric', acoustic: 'Acoustic', bass: 'Bass', classical: 'Classical',
};
const sectionLabels: Record<string, string> = {
  materials: 'Materials', technical: 'Technical', hardware: 'Hardware',
};
const fieldLabels: Record<string, string> = {
  top: 'Top', base: 'Base', neck: 'Neck', fretboard: 'Fretboard',
  headstock_top: 'Headstock Top', fretmarkers: 'Fretmarkers',
  nut: 'Nut', frets: 'Frets', details: 'Details', finish: 'Finish',
  body_shape: 'Body Shape', scale: 'Scale Length', nut_width: 'Nut Width',
  radius: 'Fingerboard Radius', neck_profile: 'Neck Profile', weight: 'Weight',
  pickups: 'Pickups', bridge: 'Bridge', tailpiece: 'Tailpiece',
  pots: 'Pots', controls: 'Controls', switch: 'Switch',
  tuners: 'Tuners', neck_plate: 'Neck Plate', strap_locks: 'Strap Locks',
  output: 'Output Jack',
};

const formattedDate = story.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Card-style mono meta: "03.09.2025 · BUILD DIARY"
const metaDate = story.data.date
  .toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' })
  .replace(/\//g, '.');
const metaLine = [metaDate, ...story.data.tags].join(' · ');
---

<PageLayout
  title={`${story.data.title} — Vibrum Guitars`}
  description={story.data.excerpt}
  ogImage={story.data.coverImage}
  ogType="article"
>
  <div class="story-detail">
    <!-- Hero — full-bleed band, same treatment as the homepage banners -->
    <section class="story-hero">
      <img src={story.data.coverImage} alt="" class="story-hero-img" />
      <div class="story-hero-shade" aria-hidden="true"></div>
      <div class="story-hero-inner container">
        <p class="story-meta">
          <time datetime={story.data.date.toISOString()} title={formattedDate}>{metaDate}</time>
          {story.data.tags.map(tag => (
            <span> · {tag}</span>
          ))}
        </p>
        <h1 class="story-title">{story.data.title}</h1>
      </div>
    </section>

    <div class="container">
      <div class="story-content-wrap">
        <article class="story-prose prose">
          <Content />
        </article>

        {guitar && (
          <aside class="story-guitar-link">
            <p class="story-guitar-label">Featured instrument</p>
            <button type="button" class="story-guitar-btn" id="story-guitar-trigger">
              View the guitar →
            </button>
          </aside>
        )}
      </div>

      <a href="/" class="back-link">&#8592; All stories</a>
    </div>
  </div>

  {guitar && GuitarContent && (
    <div id="story-guitar-wrapper" hidden>
      <template class="modal-data" data-slug={guitar.slug}>
        <div
          data-title={guitar.data.title}
          data-year={guitar.data.year}
          data-type={typeLabels[guitar.data.type] ?? guitar.data.type}
          data-status={guitar.data.status}
          data-images={JSON.stringify(guitarImages)}
        >
          <div class="modal-specs">
            {guitar.data.specs && Object.entries(guitar.data.specs).map(([sectionKey, fields]) => {
              if (!fields) return null;
              const rows = Object.entries(fields).filter(([, v]) => v !== undefined && v !== null);
              if (rows.length === 0) return null;
              return (
                <div class="spec-section">
                  <h4 class="spec-section-title">{sectionLabels[sectionKey] ?? sectionKey}</h4>
                  <dl class="spec-list">
                    {rows.map(([key, value]) => (
                      <div class="spec-row">
                        <dt class="spec-key">{fieldLabels[key] ?? key}</dt>
                        <dd class="spec-val">{String(value)}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              );
            })}
          </div>
          <div class="modal-prose prose">
            <GuitarContent />
          </div>
        </div>
      </template>
    </div>
  )}

  <GuitarModal />

  <BenchLetter />
</PageLayout>

<script>
  const trigger = document.getElementById('story-guitar-trigger');
  const wrapper = document.getElementById('story-guitar-wrapper');
  if (trigger && wrapper) {
    trigger.addEventListener('click', () => window.openGuitarModal(wrapper));
  }
</script>

<style>
  .story-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    max-height: 60vh;
    overflow: hidden;
    background-color: var(--color-bg-raised);
  }

  .story-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  /* Cover photos are light studio shots — heavy on the left where the
     title sits, deeper at the bottom so the copy always reads. */
  .story-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 9, 6, 0.92), transparent 55%),
      linear-gradient(
        to right,
        rgba(10, 9, 6, 0.9) 0%,
        rgba(10, 9, 6, 0.68) 55%,
        rgba(10, 9, 6, 0.5) 100%
      );
  }

  .story-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-lg);
  }

  .story-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  .story-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.15;
    color: #EDE7D4;
    margin: 0;
    max-width: 760px;
  }

  .story-content-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding: var(--space-md) 0 var(--space-lg);
    max-width: 900px;
  }

  @media (min-width: 768px) {
    .story-content-wrap {
      grid-template-columns: 1fr 220px;
    }
  }

  .story-prose {
    font-size: 1.05rem;
    line-height: 1.85;
    max-width: 680px;
  }

  .story-guitar-link {
    padding-top: var(--space-xs);
  }

  .story-guitar-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .story-guitar-btn {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--color-accent);
    border: 1px solid rgba(201, 168, 76, 0.35);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-dim);
    transition: background-color var(--transition), border-color var(--transition);
  }

  .story-guitar-btn:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #EDE7D4;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 6px;
    margin-bottom: var(--space-lg);
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-accent);
  }
</style>
