---
import PageLayout from '../../layouts/PageLayout.astro';
import PageLogoBg from '../../components/PageLogoBg.astro';
import { ORG_ID, webPage } from '../../lib/seo';
import { langFromUrl, langParams, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langParams().map(params => ({ params }));
}

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
// The copy lives in src/i18n/en.ts and sr.ts, under `about`.
const { description } = t.about;
---

<PageLayout
  title={t.about.title}
  description={description}
  schema={webPage('AboutPage', t.about.schemaName, '/about/', lang, { description, about: { '@id': ORG_ID } })}
>
  <PageLogoBg />

  <div class="container container--reading section">
    <h1 class="visually-hidden">{t.about.heading}</h1>

<div class="about-grid">

      <div class="grid-row story-row">
        <div class="grid-label">
          <h2 class="label-text">{t.about.storyLabel}</h2>
        </div>
        <div class="grid-content prose">
          {t.about.story.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="grid-row team-row">
        <div class="grid-label">
          <h2 class="label-text">{t.about.teamLabel}</h2>
        </div>
        <div class="grid-content">
          <div class="team-grid">
            {t.about.team.map((member, i) => (
              <div class="team-member">
                <div class="team-photo-wrap">
                  <img src={`/images/about/ProfilePhoto_0${i + 1}.webp`} alt={member.alt} class="team-photo" width="600" height="1200" decoding="async" />
                </div>
                <p class="team-name">{member.name}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="grid-row">
        <div class="grid-label">
          <h2 class="label-text">{t.about.workLabel}</h2>
        </div>
        <div class="grid-content prose">
          {t.about.work.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </div>

    </div>
  </div>
</PageLayout>

<style>
  .container {
    position: relative;
    z-index: 1;
  }

  .about-grid {
    display: flex;
    flex-direction: column;
  }

  .grid-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    align-items: start;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .grid-row:first-child {
    padding-top: 0;
  }

  .grid-row:last-child {
    border-bottom: none;
  }

  @media (max-width: 640px) {
    .container.section {
      padding-top: var(--space-md);
    }

    .grid-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      padding: var(--space-sm) 0;
    }

    .grid-label,
    .grid-content {
      padding-inline: 1.5rem;
    }

    .grid-content {
      hyphens: auto;
    }

    /* Team comes before Story on mobile */
    .team-row {
      order: -1;
      padding-top: 0;
    }

    /* Story is the DOM first child, so `.grid-row:first-child` zeroes its top
       padding. Team sits visually first here, so Story needs the spacing back —
       matched on `.grid-row.story-row` to outweigh that reset. */
    .grid-row.story-row {
      padding-top: var(--space-sm);
    }
  }

  .label-text {
    /* Overrides the global heading font so these read as labels, not headings.
       Sized to match the section eyebrows used across the site. */
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .grid-content {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-text);
    max-width: 600px;
  }

  /* Big desktops: the reading container grows to 1320px, so let the
     content cells take a little of that room too. */
  @media (min-width: 1800px) {
    .grid-content {
      max-width: 660px;
    }
  }

  /* Team */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 480px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-sm);
    }
  }

  /* Plain block layout on purpose. An earlier version made this a column
     flexbox whose photo wrapper carried `aspect-ratio` and held an image at
     `height: 100%`. Older iOS Safari (15/16-era WebKit) mislays that
     combination: the photos and names rendered one photo-height too low and
     overlapped the Story paragraph beneath. Putting the ratio on the image
     itself and spacing the name with a margin keeps every browser on the
     most basic layout path. */
  .team-member {
    display: block;
  }

  .team-photo-wrap {
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-bg), 0 0 0 5px rgba(201, 168, 76, 0.2);
  }

  .team-photo {
    width: 100%;
    height: auto;
    /* The sources are 600×1200, so browsers without `aspect-ratio` get the
       same 1:2 shape from the image's own dimensions. */
    aspect-ratio: 1 / 2;
    object-fit: cover;
    display: block;
    /* Sources are already black and white; this keeps any future colour
       replacement consistent with the rest of the row. */
    filter: grayscale(100%);
  }

  .team-name {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text);
    text-align: center;
    margin: 0.75rem 0 0;
  }

</style>
