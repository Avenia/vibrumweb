---
import PageLayout from '../layouts/PageLayout.astro';
import PageLogoBg from '../components/PageLogoBg.astro';
import { localizePath, useTranslations } from '../i18n';

const en = useTranslations('en');
const sr = useTranslations('sr');

// GitHub Pages serves this one file for every missing address, Serbian ones
// included, so it is built in English and the script below switches it to
// Serbian when the address starts with /sr/: the text here, the nav, the
// footer and the language switcher. Inline and right after the text, so it
// runs before the first paint and no English flashes by.
const serbian = {
  htmlLang: sr.meta.htmlLang,
  title: sr.notFound.title,
  // Nav links and the logo, by their English href
  links: {
    [localizePath('/', 'en')]: { href: localizePath('/', 'sr'), label: sr.nav.home },
    [localizePath('/gallery/', 'en')]: { href: localizePath('/gallery/', 'sr'), label: sr.nav.gallery },
    [localizePath('/about/', 'en')]: { href: localizePath('/about/', 'sr'), label: sr.nav.about },
    [localizePath('/contact/', 'en')]: { href: localizePath('/contact/', 'sr'), label: sr.nav.contact },
  },
  toggle: sr.nav.toggle,
  drawer: sr.nav.drawer,
  email: sr.footer.email,
  language: `${sr.nav.language}: ${sr.meta.name}`,
  code: sr.meta.code,
};
---

<PageLayout
  title={en.notFound.title}
  description={en.notFound.description}
  noindex
>
  <PageLogoBg />

  <section class="nf">
    <div class="nf-inner container">
      <!-- <p class="nf-eyebrow">404 — Page not found</p> -->
      <p class="nf-lead" data-sr={sr.notFound.lead}>
        {en.notFound.lead}
      </p>
      <div class="nf-ctas">
        <a href={localizePath('/', 'en')} class="nf-cta nf-cta--primary" data-sr={sr.notFound.home} data-sr-href={localizePath('/', 'sr')}>{en.notFound.home}</a>
        <a href={localizePath('/gallery/', 'en')} class="nf-cta nf-cta--ghost" data-sr={sr.notFound.guitars} data-sr-href={localizePath('/gallery/', 'sr')}>{en.notFound.guitars}</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ sr: serbian }}>
    if (/^\/sr(\/|$)/.test(location.pathname)) {
      document.documentElement.lang = sr.htmlLang;
      document.title = sr.title;

      document.querySelectorAll('[data-sr]').forEach(el => {
        el.textContent = el.dataset.sr;
        if (el.dataset.srHref) el.setAttribute('href', el.dataset.srHref);
      });

      document.querySelectorAll('.nav-link, .mobile-menu-link').forEach(a => {
        const link = sr.links[a.getAttribute('href')];
        if (link) {
          a.textContent = link.label;
          a.setAttribute('href', link.href);
        }
      });
      const logo = document.querySelector('.nav-logo');
      logo?.setAttribute('href', sr.links['/'].href);
      logo?.setAttribute('aria-label', sr.links['/'].label);
      document.querySelector('.nav-toggle')?.setAttribute('aria-label', sr.toggle);
      document.getElementById('mobile-menu')?.setAttribute('aria-label', sr.drawer);

      // The switcher was built showing English: show Serbian as the current one.
      const switcher = document.querySelector('.lang');
      const toggle = switcher?.querySelector('.lang-toggle');
      const srOption = switcher?.querySelector('.lang-option[data-lang="sr"]');
      if (switcher && toggle && srOption) {
        toggle.querySelector('.flag').replaceWith(srOption.querySelector('.flag').cloneNode(true));
        toggle.querySelector('.lang-code').textContent = sr.code;
        toggle.setAttribute('aria-label', sr.language);
        switcher.querySelectorAll('.lang-option').forEach(option => {
          const current = option === srOption;
          option.classList.toggle('lang-option--current', current);
          if (current) option.setAttribute('aria-current', 'true');
          else option.removeAttribute('aria-current');
        });
      }

      // The footer comes after this script.
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelector('.footer a[href^="mailto:"]')?.setAttribute('aria-label', sr.email);
      });
    }
  </script>
</PageLayout>

<style>
  .nf {
    display: flex;
    align-items: center;
    /* Fill the viewport between nav and footer so the page never looks bare. */
    min-height: calc(100svh - var(--nav-height) - 180px);
    padding-block: var(--space-xl);
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .nf-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 18px;
  }

  .nf-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.12;
    color: #EDE7D4;
    margin: 0 0 16px;
  }

  .nf-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 245, 220, 0.62);
    max-width: 520px;
    margin: 0 0 34px;
  }

  .nf-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .nf-cta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: opacity var(--transition), border-color var(--transition), color var(--transition);
  }

  .nf-cta--primary {
    background: var(--color-accent);
    color: #0a0906;
  }

  .nf-cta--primary:hover {
    opacity: 0.88;
    color: #0a0906;
  }

  .nf-cta--ghost {
    color: #EDE7D4;
    border: 1px solid rgba(255, 245, 220, 0.28);
  }

  .nf-cta--ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
