---
interface Props {
  title: string;
  slug: string;
  date: Date;
  coverImage: string;
  excerpt: string;
  tags: string[];
}

const { title, slug, date, coverImage, excerpt, tags } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const formattedDate = `${pad(date.getDate())}.${pad(date.getMonth() + 1)}.${date.getFullYear()}`;
const kicker = tags[0]?.replace(/-/g, ' ').toUpperCase();
---

<a href={`/stories/${slug}`} class="workshop-card">
  <div class="workshop-card-media">
    <img src={coverImage} alt={title} loading="lazy" />
  </div>
  <p class="workshop-card-meta">
    <time datetime={date.toISOString()}>{formattedDate}</time>{kicker && ` · ${kicker}`}
  </p>
  <h3 class="workshop-card-title">{title}</h3>
  <p class="workshop-card-excerpt">{excerpt}</p>
</a>

<style>
  /* Outlined card, same recipe as the pre-redesign StoryCard and the
     guitar strip cards: hairline border, raised bg, gold on hover. */
  .workshop-card {
    display: block;
    /* Semi-transparent take on --color-bg-raised so the band photo
       glows through the text area. */
    background-color: rgba(17, 14, 10, 0.45);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    padding-bottom: 18px;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .workshop-card:hover {
    border-color: rgba(201, 168, 76, 0.3);
    /* --color-bg-surface at matching transparency */
    background-color: rgba(26, 21, 16, 0.55);
  }

  .workshop-card-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg-surface);
    margin-bottom: 16px;
  }

  /* Text block gets side padding now that the card owns the frame
     and the image runs flush to its edges. */
  .workshop-card-meta,
  .workshop-card-title,
  .workshop-card-excerpt {
    padding-inline: 16px;
  }

  .workshop-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .workshop-card:hover .workshop-card-media img {
    transform: scale(1.03);
  }

  .workshop-card-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
    margin: 0 0 8px;
  }

  .workshop-card-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    font-size: 1.22rem;
    line-height: 1.3;
    color: #EDE7D4;
    margin: 0 0 8px;
    transition: color var(--transition);
  }

  .workshop-card:hover .workshop-card-title {
    color: var(--color-accent);
  }

  .workshop-card-excerpt {
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 245, 220, 0.48);
    margin: 0;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
