---
import type { CollectionEntry } from 'astro:content';
import GuitarModal from './GuitarModal.astro';

interface Props {
  guitars: CollectionEntry<'guitars'>[];
}

const { guitars } = Astro.props;

const statusLabels: Record<string, string> = {
  available: 'Available',
  sold: 'Sold',
  'in-progress': 'In Progress',
  commission: 'Commission',
};

const typeLabels: Record<string, string> = {
  electric:  'Electric',
  acoustic:  'Acoustic',
  bass:      'Bass',
  classical: 'Classical',
};

const sectionLabels: Record<string, string> = {
  materials: 'Materials',
  technical: 'Technical',
  hardware: 'Hardware',
};

const fieldLabels: Record<string, string> = {
  top: 'Top', base: 'Base', neck: 'Neck', fretboard: 'Fretboard',
  headstock_top: 'Headstock Top', fretmarkers: 'Fretmarkers',
  nut: 'Nut', frets: 'Frets', details: 'Details', finish: 'Finish',
  body_shape: 'Body Shape', scale: 'Scale Length', nut_width: 'Nut Width',
  radius: 'Fingerboard Radius', neck_profile: 'Neck Profile', weight: 'Weight',
  pickups: 'Pickups', bridge: 'Bridge', tailpiece: 'Tailpiece',
  pots: 'Pots', controls: 'Controls', switch: 'Switch',
  tuners: 'Tuners', neck_plate: 'Neck Plate', strap_locks: 'Strap Locks',
  output: 'Output Jack',
};

const rendered = await Promise.all(guitars.map(g => g.render()));
---

<div class="guitar-strip-wrap">
  <button class="strip-arrow strip-prev" aria-label="Previous guitars">&#8592;</button>
  <div class="guitar-strip" id="guitar-strip">
    {guitars.map((g, i) => {
      const { Content } = rendered[i];
      const images = [g.data.coverImage, ...(g.data.images ?? [])];
      return (
        <button type="button" class="strip-card strip-card-trigger">
          <div class="strip-card-image">
            <img src={g.data.coverImage} alt={g.data.title} loading="lazy" />
            {g.data.status === 'sold' && (
              <span class:list={['strip-badge', 'strip-badge--sold']}>
                {statusLabels['sold']}
              </span>
            )}
          </div>
          <p class="strip-card-title">{g.data.title}</p>

          <template class="modal-data">
            <div
              data-title={g.data.title}
              data-year={g.data.year}
              data-type={typeLabels[g.data.type] ?? g.data.type}
              data-status={g.data.status}
              data-images={JSON.stringify(images)}
            >
              <div class="modal-specs">
                {g.data.specs && Object.entries(g.data.specs).map(([sectionKey, fields]) => {
                  if (!fields) return null;
                  const rows = Object.entries(fields).filter(([, v]) => v !== undefined && v !== null);
                  if (rows.length === 0) return null;
                  return (
                    <div class="spec-section">
                      <h4 class="spec-section-title">{sectionLabels[sectionKey] ?? sectionKey}</h4>
                      <dl class="spec-list">
                        {rows.map(([key, value]) => (
                          <div class="spec-row">
                            <dt class="spec-key">{fieldLabels[key] ?? key}</dt>
                            <dd class="spec-val">{String(value)}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  );
                })}
              </div>
              <div class="modal-prose prose">
                <Content />
              </div>
            </div>
          </template>
        </button>
      );
    })}
    <a href="/gallery" class="strip-card--view-all" aria-label="View all guitars">
      <span class="strip-view-all-btn">View All Guitars &#8594;</span>
    </a>
  </div>
  <button class="strip-arrow strip-next" aria-label="Next guitars">&#8594;</button>
</div>

<GuitarModal />

<style>
  .guitar-strip-wrap {
    position: relative;
    overflow: hidden;
  }

  .guitar-strip {
    display: flex;
    justify-content: safe center;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--space-md);
    padding-block: var(--space-xs);
    margin-inline: calc(-1 * var(--space-md));
    padding-inline: var(--space-md);
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .guitar-strip::-webkit-scrollbar {
    display: none;
  }

  .strip-card {
    flex: 0 0 360px;
    scroll-snap-align: start;
    display: block;
    background-color: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition), background-color var(--transition);
    text-decoration: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .strip-card:hover {
    border-color: rgba(201, 168, 76, 0.35);
    background-color: var(--color-bg-surface);
  }

  .strip-card-image {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-bg-surface);
  }

  .strip-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .strip-card:hover .strip-card-image img {
    transform: scale(1.04);
  }

  .strip-card--view-all {
    flex: 0 0 360px;
    scroll-snap-align: start;
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .strip-view-all-btn {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: #0a0906;
    background-color: var(--color-accent);
    padding: 10px 20px;
    border-radius: var(--radius-md);
    white-space: nowrap;
    opacity: 0.8;
    transition: opacity var(--transition), transform 350ms ease;
  }

  .strip-card--view-all:hover .strip-view-all-btn {
    opacity: 1;
    transform: translateY(-2px);
  }

  .strip-badge {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  .strip-badge--sold {
    color: #d93030;
    border-color: rgba(217, 48, 48, 0.4);
  }

  .strip-card-title {
    padding: 0.55rem var(--space-xs) 0.65rem;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-size: 0.85rem;
    color: var(--color-text-bold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    margin: 0;
  }

  .strip-arrow {
    position: absolute;
    top: calc(240px - 1.1rem);
    z-index: 2;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(10, 9, 6, 0.6);
    border: 1px solid var(--color-border);
    color: var(--color-text-bold);
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition), background var(--transition), border-color var(--transition);
    padding: 0;
    line-height: 1;
  }

  .guitar-strip-wrap.is-scrollable:hover .strip-arrow {
    opacity: 0.85;
  }

  .strip-arrow:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent);
    opacity: 1;
  }

  .strip-prev { left: 0.25rem; }
  .strip-next { right: 0.25rem; }

  @media (max-width: 639px), (hover: none) {
    .strip-arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip-card-image img { transition: none; }
  }
</style>

<script>
  // ---- Strip scroll ----
  const strip = document.getElementById('guitar-strip');
  const wrap = strip?.closest('.guitar-strip-wrap') as HTMLElement | null;
  const stripPrev = wrap?.querySelector<HTMLElement>('.strip-prev');
  const stripNext = wrap?.querySelector<HTMLElement>('.strip-next');

  function syncArrows() {
    if (!strip || !wrap) return;
    const scrollable = strip.scrollWidth > strip.clientWidth;
    wrap.classList.toggle('is-scrollable', scrollable);
    const atStart = strip.scrollLeft <= 1;
    const atEnd = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1;
    if (stripPrev) stripPrev.style.visibility = atStart ? 'hidden' : '';
    if (stripNext) stripNext.style.visibility = atEnd ? 'hidden' : '';
  }

  syncArrows();
  strip?.addEventListener('scroll', syncArrows, { passive: true });
  window.addEventListener('resize', syncArrows);

  stripPrev?.addEventListener('click', () => strip?.scrollBy({ left: -376, behavior: 'smooth' }));
  stripNext?.addEventListener('click', () => strip?.scrollBy({ left: 376, behavior: 'smooth' }));

  // ---- Modal triggers ----
  document.querySelectorAll<HTMLElement>('.strip-card-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => window.openGuitarModal(trigger));
  });
</script>
