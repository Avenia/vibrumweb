---
import type { CollectionEntry } from 'astro:content';
import GuitarModal from './GuitarModal.astro';
import GuitarModalData from './GuitarModalData.astro';
import { typeLabels } from '../lib/specLabels';
import { guitarModalHash } from '../lib/seo';

interface Props {
  guitars: CollectionEntry<'guitars'>[];
}

const { guitars } = Astro.props;

// Same alt text recipe as GuitarCard, so a photo reads the same wherever it shows.
const altFor = (g: CollectionEntry<'guitars'>) =>
  `${g.data.title} — handcrafted ${(typeLabels[g.data.type] ?? g.data.type).toLowerCase()} guitar by Vibrum Guitars`;
---

<div class="guitar-strip-wrap">
  <button class="strip-arrow strip-prev" aria-label="Previous guitars">&#8592;</button>
  <div class="guitar-strip" id="guitar-strip">
    <!-- Each card links to its quick view (#guitar-<id>): a plain click opens
         the modal here, a middle-click or Cmd/Ctrl-click opens a new tab on
         the home page with the modal already open -->
    {guitars.map(g => (
      <a href={guitarModalHash(g.id)} class="strip-card strip-card-trigger">
        <img class="strip-card-img" src={g.data.coverImage} alt={altFor(g)} loading="lazy" />
        <div class="strip-card-veil" aria-hidden="true"></div>
        <div class="strip-card-caption">
          <span class="strip-card-year">{g.data.year}</span>
          <span class="strip-card-title">{g.data.title}</span>
        </div>

        <GuitarModalData guitar={g} />
      </a>
    ))}
    <a href="/gallery/" class="strip-card--view-all" aria-label="View all guitars">
      <span class="strip-view-all-label">View All<br />Guitars</span>
    </a>
  </div>
  <button class="strip-arrow strip-next" aria-label="Next guitars">&#8594;</button>
</div>

<GuitarModal />

<style>
  .guitar-strip-wrap {
    position: relative;
    overflow: hidden;
  }

  .guitar-strip {
    display: flex;
    justify-content: safe center;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--space-md);
    padding-block: var(--space-xs);
    margin-inline: calc(-1 * var(--space-md));
    padding-inline: var(--space-md);
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Big desktops: the container outgrows a non-overflowing strip, and a
     centered card cluster reads as adrift from its left-aligned section
     header — pin it to the header instead. (When the strip overflows,
     `safe center` already behaves like flex-start, so nothing changes.) */
  @media (min-width: 1800px) {
    .guitar-strip {
      justify-content: flex-start;
    }
  }

  .guitar-strip::-webkit-scrollbar {
    display: none;
  }

  .strip-card {
    /* 260px shows four full cards plus a slice of the fifth
       inside the 1200px container at desktop width. */
    flex: 0 0 260px;
    scroll-snap-align: start;
    position: relative;
    aspect-ratio: 3 / 4;
    display: block;
    background-color: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      border-color var(--transition),
      transform 350ms ease,
      box-shadow 350ms ease;
    text-decoration: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .strip-card:hover {
    border-color: rgba(201, 168, 76, 0.35);
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.45);
  }

  .strip-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .strip-card:hover .strip-card-img {
    transform: scale(1.05);
  }

  /* Bottom veil so the caption reads on any photo —
     same recipe as the band shades on the homepage. */
  .strip-card-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 9, 6, 0.88) 0%,
      rgba(10, 9, 6, 0.42) 28%,
      transparent 55%
    );
    transition: opacity var(--transition);
  }

  .strip-card-caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 14px 14px;
  }

  .strip-card-year {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--color-accent);
  }

  .strip-card-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-size: 0.9rem;
    color: #EDE7D4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }

  .strip-card--view-all {
    flex: 0 0 260px;
    scroll-snap-align: start;
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: 1px dashed rgba(201, 168, 76, 0.35);
    border-radius: var(--radius-md);
    background-color: var(--color-accent-dim);
    transition:
      border-color var(--transition),
      background-color var(--transition),
      transform 350ms ease;
  }

  .strip-card--view-all:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent-hover);
    transform: translateY(-3px);
  }

  .strip-view-all-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.6;
    color: #EDE7D4;
  }

  .strip-arrow {
    position: absolute;
    /* Cards are pure 3/4 images now, so dead center of the strip works. */
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(10, 9, 6, 0.6);
    border: 1px solid var(--color-border);
    color: var(--color-text-bold);
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition), background var(--transition), border-color var(--transition);
    padding: 0;
    line-height: 1;
  }

  .guitar-strip-wrap.is-scrollable:hover .strip-arrow {
    opacity: 0.85;
  }

  .strip-arrow:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent);
    opacity: 1;
  }

  .strip-prev { left: 0.25rem; }
  .strip-next { right: 0.25rem; }

  @media (max-width: 639px) {
    .strip-card,
    .strip-card--view-all {
      flex: 0 0 calc(100vw - 7rem);
    }
  }

  @media (max-width: 639px), (hover: none) {
    .strip-arrow { display: none; }

    /* Tame touch flings: momentum can't skip past snap points, so one
       swipe settles on the next card instead of flying down the strip. */
    .strip-card,
    .strip-card--view-all {
      scroll-snap-stop: always;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip-card,
    .strip-card-img,
    .strip-card--view-all {
      transition: none;
    }

    .strip-card:hover,
    .strip-card--view-all:hover {
      transform: none;
    }

    .strip-card:hover .strip-card-img {
      transform: none;
    }
  }
</style>

<script>
  import { isPlainClick } from '../lib/plainClick';

  // ---- Strip scroll ----
  const strip = document.getElementById('guitar-strip');
  const wrap = strip?.closest('.guitar-strip-wrap') as HTMLElement | null;
  const stripPrev = wrap?.querySelector<HTMLElement>('.strip-prev');
  const stripNext = wrap?.querySelector<HTMLElement>('.strip-next');

  function syncArrows() {
    if (!strip || !wrap) return;
    const scrollable = strip.scrollWidth > strip.clientWidth;
    wrap.classList.toggle('is-scrollable', scrollable);
    const atStart = strip.scrollLeft <= 1;
    const atEnd = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1;
    if (stripPrev) stripPrev.style.visibility = atStart ? 'hidden' : '';
    if (stripNext) stripNext.style.visibility = atEnd ? 'hidden' : '';
  }

  syncArrows();
  strip?.addEventListener('scroll', syncArrows, { passive: true });
  window.addEventListener('resize', syncArrows);

  stripPrev?.addEventListener('click', () => strip?.scrollBy({ left: -276, behavior: 'smooth' }));
  stripNext?.addEventListener('click', () => strip?.scrollBy({ left: 276, behavior: 'smooth' }));

  // ---- Modal triggers ----
  // Plain click: quick view here. Modified or middle click: the browser opens
  // a new tab on this page, where the modal opens from the hash on load.
  document.querySelectorAll<HTMLAnchorElement>('.strip-card-trigger').forEach(trigger => {
    trigger.addEventListener('click', e => {
      if (!isPlainClick(e)) return;
      e.preventDefault();
      window.openGuitarModal(trigger, 0, trigger);
    });
  });
</script>
