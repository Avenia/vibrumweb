---
// Shared guitar detail modal — open via window.openGuitarModal(cardEl)
// cardEl must contain a <template class="modal-data"> with data-title, data-year,
// data-images (JSON), and .modal-specs / .modal-prose children.
---

<div class="modal-backdrop" id="guitar-modal-backdrop" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="guitar-modal-title">

    <div class="modal-photos">
      <div class="modal-photo-stage">
        <img class="modal-photo-img" id="guitar-modal-photo-img" src="" alt="" />
        <button class="modal-nav modal-nav--prev" id="guitar-modal-prev" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="modal-nav modal-nav--next" id="guitar-modal-next" aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <div class="modal-photo-counter" id="guitar-modal-counter"></div>
      </div>
      <div class="modal-thumbs" id="guitar-modal-thumbs"></div>
    </div>

    <div class="modal-info" id="guitar-modal-info">
      <div class="modal-info-header">
        <h2 class="modal-title" id="guitar-modal-title"></h2>
        <p class="modal-year" id="guitar-modal-year"></p>
      </div>
      <div class="modal-info-body" id="guitar-modal-info-body"></div>
    </div>

    <button class="modal-close" id="guitar-modal-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

  </div>
</div>

<style>
  /* ---- Backdrop ---- */
  .modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background-color: rgba(10, 9, 6, 0.88);
    background-image: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(201, 168, 76, 0.53) 0%, transparent 70%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .modal-backdrop--open {
    display: flex;
    animation: fadeIn 180ms ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ---- Modal shell ---- */
  .modal {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 380px;
    grid-template-rows: 1fr;
    width: 100%;
    max-width: 1100px;
    height: calc(100vh - var(--space-lg) * 2);
    max-height: 780px;
    background: var(--color-bg-raised);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-md);
    overflow: hidden;
    animation: slideUp 220ms ease;
  }

  @keyframes slideUp {
    from { transform: translateY(12px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  /* ---- Photos ---- */
  .modal-photos {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border-right: 1px solid rgba(201, 168, 76, 0.15);
    overflow: hidden;
    min-height: 0;
    height: 100%;
  }

  .modal-photo-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    padding: 6px;
  }

  .modal-photo-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: var(--radius-md);
  }

  .modal-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(10, 9, 6, 0.55);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition), border-color var(--transition);
  }

  .modal-nav:hover {
    background: rgba(201, 168, 76, 0.15);
    border-color: rgba(201, 168, 76, 0.5);
  }

  .modal-nav svg { width: 18px; height: 18px; }
  .modal-nav--prev { left: 12px; }
  .modal-nav--next { right: 12px; }

  .modal-photo-counter {
    position: absolute;
    bottom: 16px;
    left: 16px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    background: rgba(10, 9, 6, 0.6);
    padding: 2px 10px;
    border-radius: 99px;
  }

  .modal-thumbs {
    display: block;
    white-space: nowrap;
    overflow-x: scroll;
    overflow-y: visible;
    flex-shrink: 0;
    padding: 10px 10px 14px;
    background: var(--color-bg-surface);
    scrollbar-width: thin;
    scrollbar-color: rgba(201, 168, 76, 0.2) transparent;
  }

  /* ---- Info panel ---- */
  .modal-info {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(201, 168, 76, 0.15) transparent;
  }

  .modal-info-header {
    padding: var(--space-md) var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .modal-title {
    font-size: 1.6rem;
    font-family: var(--font-heading);
    color: var(--color-text-bold);
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .modal-year {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .modal-info-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Cloned content has no Astro scope hash — use :global */
  :global(.modal-prose) {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    text-align: justify;
  }

  :global(.modal-prose p + p) {
    margin-top: 0.9em;
  }

  :global(.modal-specs-heading) {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }

  :global(.modal-specs) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  :global(.spec-section) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  :global(.spec-section-title) {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-bg-surface);
    padding: 7px 12px;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.spec-list) {
    background: var(--color-bg-raised);
  }

  :global(.spec-row) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 7px 12px;
  }

  :global(.spec-row:nth-child(even)) {
    background: rgba(255, 245, 220, 0.02);
  }

  :global(.spec-key) {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  :global(.spec-val) {
    font-size: 0.78rem;
    color: var(--color-text);
    text-align: right;
  }

  /* ---- Close button ---- */
  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 9, 6, 0.6);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    z-index: 10;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .modal-close:hover {
    color: var(--color-text);
    border-color: rgba(201, 168, 76, 0.5);
    background: rgba(201, 168, 76, 0.1);
  }

  .modal-close svg { width: 16px; height: 16px; }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .modal {
      grid-template-columns: 1fr;
      grid-template-rows: 55vw 1fr;
      max-height: 92vh;
    }

    .modal-photos {
      border-right: none;
      border-bottom: 1px solid rgba(201, 168, 76, 0.15);
    }
  }
</style>

<script>
  declare global {
    interface Window {
      openGuitarModal: (card: HTMLElement) => void;
    }
  }

  const backdrop  = document.getElementById('guitar-modal-backdrop')!;
  document.body.appendChild(backdrop);

  const imgEl     = document.getElementById('guitar-modal-photo-img') as HTMLImageElement;
  const counterEl = document.getElementById('guitar-modal-counter')!;
  const thumbsEl  = document.getElementById('guitar-modal-thumbs')!;
  const titleEl   = document.getElementById('guitar-modal-title')!;
  const yearEl    = document.getElementById('guitar-modal-year')!;
  const infoBody  = document.getElementById('guitar-modal-info-body')!;
  const prevBtn   = document.getElementById('guitar-modal-prev')!;
  const nextBtn   = document.getElementById('guitar-modal-next')!;
  const closeBtn  = document.getElementById('guitar-modal-close')!;

  let images: string[] = [];
  let current = 0;

  function showPhoto(index: number) {
    current = (index + images.length) % images.length;
    imgEl.src = images[current];
    counterEl.textContent = images.length > 1 ? `${current + 1} / ${images.length}` : '';
    thumbsEl.querySelectorAll<HTMLElement>('.modal-thumb').forEach((t, i) => {
      const active = i === current;
      t.style.opacity = active ? '1' : '0.46';
      t.style.outline = active ? '2px solid var(--color-accent)' : 'none';
      t.style.outlineOffset = '2px';
      if (active) t.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    });
    prevBtn.style.display = images.length > 1 ? '' : 'none';
    nextBtn.style.display = images.length > 1 ? '' : 'none';
  }

  function openModal(card: HTMLElement) {
    const tpl = card.querySelector('template.modal-data') as HTMLTemplateElement;
    const data = tpl.content.querySelector<HTMLElement>('[data-title]')!;

    images = JSON.parse(data.dataset.images!);
    current = 0;

    titleEl.textContent = data.dataset.title!;
    yearEl.textContent = data.dataset.year!;

    infoBody.innerHTML = '';
    infoBody.appendChild(data.querySelector('.modal-prose')!.cloneNode(true));
    const specsHeading = document.createElement('p');
    specsHeading.className = 'modal-specs-heading';
    specsHeading.textContent = 'Specifications';
    infoBody.appendChild(specsHeading);
    infoBody.appendChild(data.querySelector('.modal-specs')!.cloneNode(true));

    backdrop.setAttribute('aria-hidden', 'false');
    backdrop.classList.add('modal-backdrop--open');
    document.body.style.overflow = 'hidden';
    document.getElementById('guitar-modal-info')!.scrollTop = 0;

    setTimeout(() => {
      const stripWidth = thumbsEl.clientWidth || 600;
      const thumbSize = Math.floor((stripWidth - 20 - 10 * 6) / 10);

      thumbsEl.innerHTML = '';
      images.forEach((src, i) => {
        const btn = document.createElement('button');
        btn.className = 'modal-thumb';
        btn.style.width = thumbSize + 'px';
        btn.style.marginRight = '6px';
        btn.style.cursor = 'pointer';
        btn.style.padding = '0';
        btn.style.border = 'none';
        btn.style.borderRadius = '4px';
        btn.style.flexShrink = '0';
        btn.style.verticalAlign = 'top';
        btn.setAttribute('aria-label', `Photo ${i + 1}`);
        const img = document.createElement('img');
        img.src = src;
        img.alt = '';
        img.loading = 'lazy';
        img.style.width = '100%';
        img.style.height = 'auto';
        img.style.display = 'block';
        img.style.borderRadius = '4px';
        btn.appendChild(img);
        btn.addEventListener('click', () => showPhoto(i));
        thumbsEl.appendChild(btn);
      });

      showPhoto(0);
    }, 0);
  }

  function closeModal() {
    backdrop.setAttribute('aria-hidden', 'true');
    backdrop.classList.remove('modal-backdrop--open');
    document.body.style.overflow = '';
  }

  window.openGuitarModal = openModal;

  prevBtn.addEventListener('click', () => showPhoto(current - 1));
  nextBtn.addEventListener('click', () => showPhoto(current + 1));
  closeBtn.addEventListener('click', closeModal);

  backdrop.addEventListener('click', e => {
    if (e.target === backdrop) closeModal();
  });

  document.addEventListener('keydown', e => {
    if (!backdrop.classList.contains('modal-backdrop--open')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft')  { e.preventDefault(); showPhoto(current - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); showPhoto(current + 1); }
  });
</script>
