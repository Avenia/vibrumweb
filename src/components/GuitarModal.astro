---
// Shared guitar detail modal — open via window.openGuitarModal(cardEl)
// cardEl must contain a <template class="modal-data"> with data-title, data-year,
// data-images (JSON), and .modal-specs / .modal-prose children.
---

<div class="modal-backdrop" id="guitar-modal-backdrop" aria-hidden="true">
  <div class="modal-shell" role="dialog" aria-modal="true" aria-labelledby="guitar-modal-title">
    <button class="modal-close" id="guitar-modal-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="modal">

    <div class="modal-photos">
      <div class="modal-photo-stage">
        <img class="modal-photo-img" id="guitar-modal-photo-img" src="" alt="" />
        <button class="modal-nav modal-nav--prev" id="guitar-modal-prev" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="modal-nav modal-nav--next" id="guitar-modal-next" aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <div class="modal-photo-counter" id="guitar-modal-counter"></div>
      <div class="modal-thumbs" id="guitar-modal-thumbs"></div>
    </div>

    <div class="modal-info" id="guitar-modal-info">
      <div class="modal-info-header">
        <h2 class="modal-title" id="guitar-modal-title"></h2>
        <p class="modal-year" id="guitar-modal-year"></p>
      </div>
      <div class="modal-info-body" id="guitar-modal-info-body"></div>
    </div>

    </div>
  </div>
</div>

<style>
  /* ---- Backdrop ---- */
  .modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background-color: rgba(10, 9, 6, 0.88);
    background-image: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(201, 168, 76, 0.53) 0%, transparent 70%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .modal-backdrop--open {
    display: flex;
    animation: fadeIn 180ms ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ---- Modal shell ---- */
  .modal-shell {
    position: relative;
    width: 100%;
    max-width: 1100px;
    height: calc(100vh - var(--space-lg) * 2);
    max-height: 780px;
    /* As a flex item of the backdrop, min-width:auto would let the photo's
       intrinsic width push the dialog wider than the viewport. */
    min-width: 0;
    animation: slideUp 220ms ease;
  }

  .modal-close {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: 10px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 9, 6, 0.55);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }

  .modal-close:hover {
    background: rgba(201, 168, 76, 0.15);
    border-color: rgba(201, 168, 76, 0.5);
  }

  .modal-close svg { width: 18px; height: 18px; }

  .modal {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 380px;
    grid-template-rows: 1fr;
    width: 100%;
    height: 100%;
    background: var(--color-bg-raised);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-md);
    overflow: hidden;
    touch-action: pan-x pan-y;
  }

  @keyframes slideUp {
    from { transform: translateY(12px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  /* ---- Photos ---- */
  .modal-photos {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border-right: 1px solid rgba(201, 168, 76, 0.15);
    overflow: hidden;
    min-height: 0;
    height: 100%;
  }

  .modal-photo-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    touch-action: none;
  }

  .modal-photo-img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .modal-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(10, 9, 6, 0.55);
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition), border-color var(--transition);
  }

  .modal-nav:hover {
    background: rgba(201, 168, 76, 0.15);
    border-color: rgba(201, 168, 76, 0.5);
  }

  .modal-nav svg { width: 18px; height: 18px; }
  .modal-nav--prev { left: 12px; }
  .modal-nav--next { right: 12px; }

  .modal-photo-counter {
    flex-shrink: 0;
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    background: var(--color-bg-surface);
    padding: 4px 0;
    border-top: 1px solid rgba(201, 168, 76, 0.1);
    border-bottom: 1px solid rgba(201, 168, 76, 0.1);
  }

  .modal-photo-counter:empty {
    display: none;
  }

  .modal-thumbs {
    display: block;
    white-space: nowrap;
    overflow-x: scroll;
    overflow-y: visible;
    flex-shrink: 0;
    padding: 10px 10px 14px;
    background: var(--color-bg-surface);
    scrollbar-width: thin;
    scrollbar-color: rgba(201, 168, 76, 0.2) transparent;
  }

  /* ---- Info panel ---- */
  .modal-info {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(201, 168, 76, 0.15) transparent;
  }

  .modal-info-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .modal-title {
    font-size: 1.6rem;
    font-family: var(--font-heading);
    color: var(--color-text-bold);
    line-height: 1.2;
    margin: 0;
  }

  .modal-year {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .modal-info-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Cloned content has no Astro scope hash — use :global */
  :global(.modal-prose) {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  :global(.modal-prose p + p) {
    margin-top: 0.9em;
  }

  :global(.modal-specs-heading) {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }

  /* Section wrappers (desktop: always-open, non-interactive label) */
  :global(.modal-section-title) {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    list-style: none;
    display: block;
    padding: 0;
    margin: 0 0 var(--space-xs);
    pointer-events: none;
    cursor: default;
  }

  :global(.modal-section-title::-webkit-details-marker) { display: none; }
  :global(.modal-section-title::marker) { display: none; }

  :global(.modal-specs) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  :global(.spec-section) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  :global(.spec-section-title) {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-bg-surface);
    padding: 7px 12px;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.spec-list) {
    background: var(--color-bg-raised);
  }

  :global(.spec-row) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 7px 12px;
  }

  :global(.spec-row:nth-child(even)) {
    background: rgba(255, 245, 220, 0.02);
  }

  :global(.spec-key) {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  :global(.spec-val) {
    font-size: 0.78rem;
    color: var(--color-text);
    text-align: right;
  }


  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .modal-backdrop {
      padding: var(--space-xs);
      align-items: center;
    }

    .modal-shell {
      height: 92svh;
      max-height: 92svh;
    }

    .modal {
      display: flex;
      flex-direction: column;
      /* The desktop backlight is the backdrop's radial glow; on mobile the dialog
         covers nearly the whole screen, so glow the frame itself instead. */
      box-shadow: 0 0 28px rgba(201, 168, 76, 0.35);
    }

    /* Touch users close via backdrop tap, swipe-back, or the browser back button. */
    .modal-close { display: none; }

    .modal-photos {
      flex: 1 1 0;
      min-height: 0;
      border-right: none;
      border-bottom: 1px solid rgba(201, 168, 76, 0.15);
    }

    .modal-info {
      flex: 0 0 auto;
      max-height: 55svh;
    }

    .modal-info-header {
      padding: var(--space-sm) var(--space-md);
    }

    .modal-title { font-size: 1.2rem; }

    .modal-info-body {
      padding: 0;
      gap: 0;
    }

    /* Collapsible sections */
    :global(.modal-section) {
      border-top: 1px solid var(--color-border);
    }

    :global(.modal-section-title) {
      pointer-events: auto;
      cursor: pointer;
      display: flex;
      align-items: center;
      padding: 14px var(--space-md);
      margin: 0;
      background: var(--color-bg-surface);
      user-select: none;
      font-size: 0.7rem;
    }

    :global(.modal-section-title)::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      border-right: 2px solid var(--color-accent);
      border-bottom: 2px solid var(--color-accent);
      transform: rotate(-45deg);
      margin-right: 10px;
      transition: transform 0.18s ease;
      flex-shrink: 0;
    }

    :global(details[open].modal-section .modal-section-title)::before {
      transform: rotate(45deg);
    }

    /* While collapsing, [open] is still set (removed after the transition) —
       fold the chevron back right away so it doesn't lag the tap. */
    :global(details.modal-section.is-closing .modal-section-title)::before {
      transform: rotate(-45deg);
    }

    :global(details[open].modal-section .modal-section-title) {
      border-bottom: 1px solid var(--color-border);
    }

    :global(.modal-section-body) {
      display: grid;
      grid-template-rows: 0fr;
      overflow: hidden;
      transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    :global(.modal-section-body-inner) {
      min-height: 0;
      /* No padding here: padding on the grid item puts a ~48px floor under the
         0fr track, so the collapse stops short and pops at the end. Space the
         content with margin instead; overflow keeps it out of track sizing. */
      overflow: hidden;
    }

    :global(.modal-section-body-inner > *) {
      margin: var(--space-sm) var(--space-md) var(--space-md);
    }

    .modal-nav { display: none; }
  }
</style>

<script>
  declare global {
    interface Window {
      openGuitarModal: (card: HTMLElement) => void;
    }
  }

  const backdrop  = document.getElementById('guitar-modal-backdrop')!;
  document.body.appendChild(backdrop);

  let imgEl        = document.getElementById('guitar-modal-photo-img') as HTMLImageElement;
  const counterEl = document.getElementById('guitar-modal-counter')!;
  const thumbsEl  = document.getElementById('guitar-modal-thumbs')!;
  const titleEl   = document.getElementById('guitar-modal-title')!;
  const yearEl    = document.getElementById('guitar-modal-year')!;
  const infoBody  = document.getElementById('guitar-modal-info-body')!;
  const prevBtn   = document.getElementById('guitar-modal-prev')!;
  const nextBtn   = document.getElementById('guitar-modal-next')!;
  const closeBtn  = document.getElementById('guitar-modal-close')!;

  let images: string[] = [];
  let current = 0;
  let isSliding = false;
  let lastTrigger: HTMLElement | null = null;

  function updateUI() {
    counterEl.textContent = images.length > 1 ? `${current + 1} / ${images.length}` : '';
    thumbsEl.querySelectorAll<HTMLElement>('.modal-thumb').forEach((t, i) => {
      const active = i === current;
      t.style.opacity = active ? '1' : '0.46';
      t.style.outline = active ? '2px solid var(--color-accent)' : 'none';
      t.style.outlineOffset = '2px';
      if (active) t.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    });
    prevBtn.style.display = images.length > 1 ? '' : 'none';
    nextBtn.style.display = images.length > 1 ? '' : 'none';
  }

  function showPhoto(index: number, dir: -1 | 0 | 1 = 0) {
    const next = (index + images.length) % images.length;

    if (dir === 0 || images.length <= 1 || next === current) {
      current = next;
      imgEl.src = images[current];
      updateUI();
      return;
    }

    if (isSliding) return;
    isSliding = true;

    const stage = imgEl.parentElement as HTMLElement;
    const stageW = stage.clientWidth;
    // BASE mirrors the static CSS: centered portrait image, absolute so both can stack during slide
    const BASE = 'position:absolute;inset:0;margin:auto;height:100%;width:auto;max-width:100%;object-fit:contain;display:block';
    const TRANS_OUT = 'transition:transform 0.28s cubic-bezier(0.4,0,0.2,1),opacity 0.2s ease';
    const TRANS_IN  = 'transition:transform 0.28s cubic-bezier(0.4,0,0.2,1)';

    imgEl.setAttribute('style', `${BASE};${TRANS_OUT}`);

    const incoming = new Image();
    incoming.src = images[next];
    incoming.alt = imgEl.alt;
    // Offset by full stage width (px) so it starts fully off-screen regardless of image width
    incoming.setAttribute('style', `${BASE};${TRANS_IN};transform:translateX(${dir * stageW}px)`);
    stage.appendChild(incoming);

    incoming.getBoundingClientRect(); // force reflow
    imgEl.style.transform = `translateX(${-dir * stageW}px)`;
    imgEl.style.opacity = '0';
    incoming.style.transform = 'translateX(0)';

    let done = false;
    function finish() {
      if (done) return;
      done = true;
      current = next;
      // Promote `incoming` to be the persistent image element (avoids src-change flash).
      // Use inline styles — dynamically created elements lack Astro's scoped CSS attribute.
      incoming.style.cssText = 'height:100%;width:auto;max-width:100%;object-fit:contain;display:block';
      stage.removeChild(imgEl);
      imgEl = incoming as HTMLImageElement;
      isSliding = false;
      updateUI();
    }

    incoming.addEventListener('transitionend', finish, { once: true });
    setTimeout(finish, 400);
  }

  function openModal(card: HTMLElement) {
    const tpl = card.querySelector('template.modal-data') as HTMLTemplateElement;
    const slug = tpl.dataset.slug ?? '';
    const data = tpl.content.querySelector<HTMLElement>('[data-title]')!;

    images = JSON.parse(data.dataset.images!);
    current = 0;

    // The strip card is itself the trigger button; the gallery card wraps one.
    lastTrigger = card.closest<HTMLElement>('button') ?? card.querySelector<HTMLElement>('button');

    titleEl.textContent = data.dataset.title!;
    yearEl.textContent = data.dataset.year!;
    imgEl.alt = data.dataset.title!;

    infoBody.innerHTML = '';

    const isMobile = window.innerWidth <= 768;

    function makeSection(label: string, contentNode: Node) {
      const det = document.createElement('details');
      det.className = 'modal-section';
      if (!isMobile) det.open = true;
      const sum = document.createElement('summary');
      sum.className = 'modal-section-title';
      sum.textContent = label;
      det.appendChild(sum);
      const body = document.createElement('div');
      body.className = 'modal-section-body';
      const inner = document.createElement('div');
      inner.className = 'modal-section-body-inner';
      inner.appendChild(contentNode);
      body.appendChild(inner);
      det.appendChild(body);

      if (isMobile) {
        // Constant expand/collapse velocity: a fixed duration makes tall sections
        // (Specifications) sweep visibly faster than short ones (Description).
        const SPEED = 1.2; // px per ms — matches the original 300ms Description feel
        const durationFor = (distance: number) => `${Math.max(120, distance / SPEED)}ms`;
        let onClosed: (() => void) | null = null;
        sum.addEventListener('click', (e) => {
          e.preventDefault();
          // Drop any pending close finalization so a tap mid-animation reverses
          // the transition instead of wedging the section in a stale state.
          if (onClosed) {
            body.removeEventListener('transitionend', onClosed);
            onClosed = null;
          }
          if (det.open && !det.classList.contains('is-closing')) {
            det.classList.add('is-closing'); // chevron folds back immediately
            body.style.transitionDuration = durationFor(body.offsetHeight);
            body.style.gridTemplateRows = '0fr';
            onClosed = () => {
              onClosed = null;
              det.open = false;
              det.classList.remove('is-closing');
              body.style.gridTemplateRows = '';
              body.style.transitionDuration = '';
            };
            body.addEventListener('transitionend', onClosed, { once: true });
          } else {
            det.classList.remove('is-closing');
            if (!det.open) {
              det.open = true;
              // Force a layout so the collapsed (0fr) state is committed;
              // otherwise the expand races the first paint and pops open.
              void body.offsetHeight;
            }
            body.style.transitionDuration = durationFor(inner.scrollHeight - body.offsetHeight);
            body.style.gridTemplateRows = '1fr';
          }
        });
      }

      return det;
    }

    infoBody.appendChild(makeSection('Description', data.querySelector('.modal-prose')!.cloneNode(true)));
    infoBody.appendChild(makeSection('Specifications', data.querySelector('.modal-specs')!.cloneNode(true)));

    backdrop.setAttribute('aria-hidden', 'false');
    backdrop.classList.add('modal-backdrop--open');
    document.body.style.overflow = 'hidden';
    document.getElementById('guitar-modal-info')!.scrollTop = 0;
    closeBtn.focus();
    if (slug) history.pushState(null, '', '#guitar-' + slug);

    setTimeout(() => {
      const stripWidth = thumbsEl.clientWidth || 600;
      const thumbSize = Math.floor((stripWidth - 20 - 10 * 6) / 10);

      thumbsEl.innerHTML = '';
      images.forEach((src, i) => {
        const btn = document.createElement('button');
        btn.className = 'modal-thumb';
        btn.style.width = thumbSize + 'px';
        btn.style.marginRight = '6px';
        btn.style.cursor = 'pointer';
        btn.style.padding = '0';
        btn.style.border = 'none';
        btn.style.borderRadius = '4px';
        btn.style.flexShrink = '0';
        btn.style.display = 'inline-block';
        btn.style.verticalAlign = 'top';
        btn.setAttribute('aria-label', `Photo ${i + 1}`);
        const img = document.createElement('img');
        img.src = src;
        img.alt = '';
        img.loading = 'lazy';
        img.style.width = '100%';
        img.style.height = 'auto';
        img.style.display = 'block';
        img.style.borderRadius = '4px';
        btn.appendChild(img);
        btn.addEventListener('click', () => showPhoto(i));
        thumbsEl.appendChild(btn);
      });

      showPhoto(0);
    }, 0);
  }

  function hideModal() {
    // Return focus before hiding so it never sits inside an aria-hidden tree.
    lastTrigger?.focus();
    backdrop.setAttribute('aria-hidden', 'true');
    backdrop.classList.remove('modal-backdrop--open');
    document.body.style.overflow = '';
  }

  function closeModal() {
    hideModal();
    if (location.hash.startsWith('#guitar-')) {
      history.replaceState(null, '', location.pathname + location.search);
    }
  }

  window.openGuitarModal = openModal;

  window.addEventListener('popstate', () => {
    if (backdrop.classList.contains('modal-backdrop--open')) hideModal();
  });

  const initHash = location.hash;
  if (initHash.startsWith('#guitar-')) {
    const slug = initHash.slice(8);
    const tpl = document.querySelector<HTMLElement>(`template.modal-data[data-slug="${slug}"]`);
    const card = tpl?.closest<HTMLElement>('.guitar-card-wrapper, .strip-card-trigger');
    if (card) openModal(card);
  }

  prevBtn.addEventListener('click', () => showPhoto(current - 1, -1));
  nextBtn.addEventListener('click', () => showPhoto(current + 1, 1));
  closeBtn.addEventListener('click', closeModal);

  // Swipe to change photos + pinch to zoom image
  let swipeStartX = 0;
  let swipeStartY = 0;
  let swipeLocked = false;
  let isPinching = false;
  let pinchStartDist = 0;

  const stage = document.querySelector('.modal-photo-stage')!;

  function getPinchDist(e: TouchEvent) {
    const dx = e.touches[0].clientX - e.touches[1].clientX;
    const dy = e.touches[0].clientY - e.touches[1].clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }

  stage.addEventListener('touchstart', (e: Event) => {
    const te = e as TouchEvent;
    if (te.touches.length >= 2) {
      swipeLocked = true;
      if (!isSliding) {
        isPinching = true;
        pinchStartDist = getPinchDist(te);
        const rect = imgEl.getBoundingClientRect();
        const midX = (te.touches[0].clientX + te.touches[1].clientX) / 2;
        const midY = (te.touches[0].clientY + te.touches[1].clientY) / 2;
        imgEl.style.transformOrigin = `${((midX - rect.left) / rect.width) * 100}% ${((midY - rect.top) / rect.height) * 100}%`;
      }
      te.preventDefault();
      return;
    }
    const t = te.touches[0];
    swipeStartX = t.clientX;
    swipeStartY = t.clientY;
    swipeLocked = false;
    isPinching = false;
  }, { passive: false });

  stage.addEventListener('touchmove', (e: Event) => {
    const te = e as TouchEvent;
    if (isPinching && te.touches.length >= 2) {
      const scale = Math.max(1, Math.min(4, getPinchDist(te) / pinchStartDist));
      imgEl.style.transition = 'none';
      imgEl.style.transform = `scale(${scale})`;
      te.preventDefault();
      return;
    }
    if (isPinching) return;
    const t = te.touches[0];
    const dy = Math.abs(t.clientY - swipeStartY);
    const dx = Math.abs(t.clientX - swipeStartX);
    if (dy > dx) swipeLocked = true;
  }, { passive: false });

  stage.addEventListener('touchend', (e: Event) => {
    const te = e as TouchEvent;
    if (isPinching) {
      if (te.touches.length < 2) {
        isPinching = false;
        imgEl.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
        imgEl.style.transform = 'scale(1)';
        imgEl.addEventListener('transitionend', () => {
          imgEl.style.transition = '';
          imgEl.style.transform = '';
          imgEl.style.transformOrigin = '';
        }, { once: true });
      }
      return;
    }
    if (swipeLocked) return;
    const t = te.changedTouches[0];
    const dx = t.clientX - swipeStartX;
    const dy = t.clientY - swipeStartY;
    if (Math.abs(dx) < 30 || Math.abs(dy) > Math.abs(dx)) return;
    dx < 0 ? showPhoto(current + 1, 1) : showPhoto(current - 1, -1);
  }, { passive: false });


  backdrop.addEventListener('click', e => {
    if (e.target === backdrop) closeModal();
  });

  document.addEventListener('keydown', e => {
    if (!backdrop.classList.contains('modal-backdrop--open')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft')  { e.preventDefault(); showPhoto(current - 1, -1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); showPhoto(current + 1, 1); }
  });
</script>
