---
import { getCollection } from 'astro:content';

const slideEntries = (await getCollection('slides')).sort((a, b) => a.id.localeCompare(b.id));
const slides = slideEntries.map(e => e.data);
---

<section class="hero" id="hero" aria-label="Vibrum — handcrafted guitars">
  <div class="hero-media" aria-hidden="true">
    {slides.map((slide, i) => (
      <div class={`hero-slide${i === 0 ? ' active' : ''}`} data-index={i}>
        <img
          src={slide.src}
          alt={slide.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      </div>
    ))}
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-inner container">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-line">Handcrafted guitars</span>
        <span class="hero-line hero-line-accent">Built to resonate</span>
      </h1>
      <p class="hero-lead">
        We build a limited number of instruments a year.
        One at a time, by hand, for players who know what they want to feel.
      </p>
      <div class="hero-ctas">
        <a href="/gallery" class="hero-cta hero-cta--primary">Explore guitars</a>
        <a href="/contact" class="hero-cta hero-cta--ghost">Get in touch</a>
      </div>
    </div>

    {slides.map((slide, i) => (
      <div
        class={`hero-caption${i === 0 ? ' active' : ''}`}
        data-index={i}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        {slide.caption && <span class="hero-caption-title">{slide.caption}</span>}
        {slide.detail && <span class="hero-caption-detail">{slide.detail}</span>}
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button class="hero-arrow hero-prev" aria-label="Previous slide">&#8592;</button>
      <button class="hero-arrow hero-next" aria-label="Next slide">&#8594;</button>
      <div class="hero-dots">
        {slides.map((_, i) => (
          <button class={`hero-dot${i === 0 ? ' active' : ''}`} data-index={i} aria-label={`Go to slide ${i + 1}`}></button>
        ))}
      </div>
    </>
  )}
</section>



<style>
  .hero {
    position: relative;
    width: 100%;
    height: clamp(540px, calc(100svh - var(--nav-height)), 820px);
    overflow: hidden;
    background: var(--color-bg);
  }

  /* ---- Rotating background ---- */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .hero-slide.active {
    opacity: 1;
  }

  /* Ken Burns — always applied, paused when not active so the transform is
     held at the `from` state and never snaps to scale(1) during fade-out. */
  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 45%;
    transform-origin: 60% 50%;
    animation-name: hero-kb-zoom-in;
    animation-duration: 8s;
    animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    animation-fill-mode: both;
    animation-play-state: paused;
  }

  .hero-slide:nth-child(2n) img {
    animation-name: hero-kb-zoom-out;
    transform-origin: 40% 60%;
  }

  .hero-slide:nth-child(3n) img {
    animation-name: hero-kb-pan-right;
    transform-origin: 30% 50%;
  }

  .hero-slide:nth-child(4n) img {
    animation-name: hero-kb-pan-left;
    transform-origin: 70% 50%;
  }

  .hero-slide.active img {
    animation-play-state: running;
  }

  @keyframes hero-kb-zoom-in {
    from { transform: scale(1.08) translateX(0); }
    to   { transform: scale(1.14) translateX(-1.5%); }
  }

  @keyframes hero-kb-zoom-out {
    from { transform: scale(1.12) translateX(0); }
    to   { transform: scale(1.06) translateX(1%); }
  }

  @keyframes hero-kb-pan-right {
    from { transform: scale(1.1) translateX(-1%); }
    to   { transform: scale(1.1) translateX(1%); }
  }

  @keyframes hero-kb-pan-left {
    from { transform: scale(1.1) translateX(1%); }
    to   { transform: scale(1.1) translateX(-1%); }
  }

  /* ---- Editorial shade — heavy on the left where the copy sits ---- */
  /* Monotonic left-to-right: darkest under the copy, brightest at the
     right edge. The bottom layer keeps the corner caption readable. */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(to top, rgba(10, 9, 6, 0.62), transparent 24%),
      linear-gradient(100deg,
        rgba(10, 9, 6, 0.94) 0%,
        rgba(10, 9, 6, 0.85) 42%,
        rgba(10, 9, 6, 0.45) 70%,
        rgba(10, 9, 6, 0.12) 100%);
  }

  /* ---- Copy ---- */
  .hero-inner {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .hero-content {
    max-width: 760px;
    padding-bottom: var(--space-md);
  }

  .hero-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    font-size: clamp(2.1rem, 5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #EDE7D4;
    margin: 0 0 24px;
  }

  /* Fast left-to-right wipe, all three lines together. */
  .hero-line {
    display: block;
    animation: hero-wipe 420ms ease-out both;
  }

  .hero-line-accent {
    font-family: var(--font-heading);
    font-weight: 400;
    font-style: italic;
    font-size: 0.92em;
    color: var(--color-accent);
  }

  .hero-lead {
    font-size: clamp(0.92rem, 1.3vw, 1.05rem);
    line-height: 1.65;
    color: rgba(255, 245, 220, 0.62);
    max-width: 480px;
    margin: 0 0 32px;
    animation: hero-fade 380ms ease-out 320ms both;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    animation: hero-fade 380ms ease-out 420ms both;
  }

  .hero-cta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: opacity var(--transition), border-color var(--transition), color var(--transition);
  }

  .hero-cta--primary {
    background: var(--color-accent);
    color: #0a0906;
  }

  .hero-cta--primary:hover {
    opacity: 0.88;
    color: #0a0906;
  }

  .hero-cta--ghost {
    color: #EDE7D4;
    border: 1px solid rgba(255, 245, 220, 0.28);
  }

  .hero-cta--ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ---- Per-slide caption, bottom right ---- */
  .hero-caption {
    position: absolute;
    right: var(--space-md);
    bottom: 2.2rem;
    z-index: 4;
    max-width: 55%;
    text-align: right;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Informational label only — never interactive, so no pointer-events
     even while visible. */
  .hero-caption.active {
    opacity: 1;
  }

  .hero-caption-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 245, 220, 0.68);
    transition: color var(--transition);
  }

  .hero-caption-detail {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: rgba(255, 245, 220, 0.36);
    margin-top: 4px;
  }

  /* ---- Arrows — revealed on hover (and keyboard focus) ---- */
  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    background: rgba(10, 9, 6, 0.35);
    border: 2px solid var(--color-border);
    color: var(--color-text-bold);
    width: clamp(2rem, 4vw, 2.5rem);
    height: clamp(2rem, 4vw, 2.5rem);
    border-radius: 50%;
    font-size: clamp(0.8rem, 1.5vw, 1.1rem);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background var(--transition), border-color var(--transition), opacity var(--transition), transform var(--transition);
  }

  .hero:hover .hero-arrow,
  .hero-arrow:focus-visible {
    opacity: 0.85;
  }

  .hero-arrow:hover {
    background: rgba(201, 168, 76, 0.18);
    border-color: var(--color-accent);
  }

  .hero-prev { left: var(--space-sm); }
  .hero-next { right: var(--space-sm); }

  .hero-prev:hover { transform: translateY(-50%) translateX(-2px); }
  .hero-next:hover { transform: translateY(-50%) translateX(2px); }

  @media (max-width: 639px), (hover: none) {
    .hero-arrow { display: none; }
  }

  /* ---- Dots ---- */
  .hero-dots {
    position: absolute;
    bottom: 1.15rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.6rem;
    z-index: 5;
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    opacity: 0.7;
    border-radius: 3px;
    border: none;
    background: rgba(255, 245, 220, 0.35);
    cursor: pointer;
    padding: 0;
    transition: background var(--transition), transform 0.3s ease;
  }

  .hero-dot.active {
    background: var(--color-accent);
    transform: scale(1.35);
  }

  /* ---- Entrance animations ---- */
  @keyframes hero-step {
    0%, 42%   { opacity: 0; }
    50%, 100% { opacity: 1; }
  }

  /* Negative vertical insets: the title's tight line-height (1.02) puts
     descenders (y, g) outside the line box, and a 0 inset would slice them. */
  @keyframes hero-wipe {
    from { clip-path: inset(-20% 100% -20% 0); }
    to   { clip-path: inset(-20% -2% -20% 0); }
  }

  @keyframes hero-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* First visit: the splash logo covers the page, so hold the entrance
     animations at frame 0 until BaseLayout removes `splash-show` when the
     splash finishes fading — the reveal then plays in full view. */
  :global(html.splash-show) .hero-line,
  :global(html.splash-show) .hero-lead,
  :global(html.splash-show) .hero-ctas {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line,
    .hero-lead,
    .hero-ctas {
      animation: none;
    }
  }

  /* ---- Responsive ---- */
  @media (max-width: 639px) {
    .hero-shade {
      background:
        linear-gradient(to top, rgba(10, 9, 6, 0.72), transparent 30%),
        linear-gradient(100deg,
          rgba(10, 9, 6, 0.92) 0%,
          rgba(10, 9, 6, 0.80) 55%,
          rgba(10, 9, 6, 0.55) 80%,
          rgba(10, 9, 6, 0.45) 100%);
    }

    .hero-content {
      padding-bottom: var(--space-lg);
    }

    /* Sized so each headline line fits without a ragged mid-span wrap. */
    .hero-title {
      font-size: clamp(1.85rem, 8.4vw, 2.35rem);
      margin-bottom: 18px;
    }

    .hero-lead {
      margin-bottom: 26px;
    }

    /* Clear the dots row so caption and dots never collide. */
    .hero-caption {
      right: var(--space-sm);
      bottom: 2.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition-duration: 0.01s;
    }

    .hero-slide img,
    .hero-line,
    .hero-lead,
    .hero-ctas {
      animation: none;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');
  if (hero) {
    const slideEls = Array.from(hero.querySelectorAll<HTMLElement>('.hero-slide'));
    const captionEls = Array.from(hero.querySelectorAll<HTMLElement>('.hero-caption'));
    const dotEls = Array.from(hero.querySelectorAll<HTMLElement>('.hero-dot'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const ADVANCE_MS = 6000;
    let current = 0;
    let timer: ReturnType<typeof setTimeout> | null = null;

    function schedule() {
      if (timer) clearTimeout(timer);
      if (!reducedMotion && slideEls.length > 1) {
        timer = setTimeout(() => goTo(current + 1), ADVANCE_MS);
      }
    }

    function setCaptionState(el: HTMLElement | undefined, active: boolean) {
      if (!el) return;
      el.classList.toggle('active', active);
      el.setAttribute('aria-hidden', String(!active));
      if (el instanceof HTMLAnchorElement) el.tabIndex = active ? 0 : -1;
    }

    function goTo(index: number) {
      if (slideEls.length < 2) return;
      if (timer) clearTimeout(timer);
      slideEls[current].classList.remove('active');
      dotEls[current]?.classList.remove('active');
      setCaptionState(captionEls[current], false);
      current = (index + slideEls.length) % slideEls.length;
      // Reset KB animation so it always starts from frame 0 on the incoming slide.
      const img = slideEls[current].querySelector('img');
      if (img) {
        img.style.animationName = 'none';
        void img.offsetWidth; // force reflow to flush the reset
        img.style.animationName = '';
      }
      slideEls[current].classList.add('active');
      dotEls[current]?.classList.add('active');
      setCaptionState(captionEls[current], true);
      schedule();
    }

    dotEls.forEach(dot => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));
    hero.querySelector('.hero-prev')?.addEventListener('click', () => goTo(current - 1));
    hero.querySelector('.hero-next')?.addEventListener('click', () => goTo(current + 1));


    // --- Touch & mouse swipe. Drags that start on a link or button are left alone. ---
    let dragStartX = 0;
    let dragging = false;

    hero.addEventListener('touchstart', e => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      dragStartX = e.touches[0].clientX;
      dragging = true;
    }, { passive: true });
    hero.addEventListener('touchend', e => {
      if (!dragging) return;
      dragging = false;
      const diff = dragStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(current + (diff > 0 ? 1 : -1));
    }, { passive: true });

    hero.addEventListener('mousedown', e => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      dragStartX = e.clientX;
      dragging = true;
    });
    hero.addEventListener('mousemove', e => {
      if (dragging) e.preventDefault();
    });
    hero.addEventListener('mouseup', e => {
      if (!dragging) return;
      dragging = false;
      const diff = dragStartX - e.clientX;
      if (Math.abs(diff) > 40) goTo(current + (diff > 0 ? 1 : -1));
    });
    hero.addEventListener('mouseleave', () => {
      dragging = false;
    });

    schedule();
  }
</script>
