---
const pathname = Astro.url.pathname;

const links = [
  { href: '/',        label: 'Home' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about',   label: 'About' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav class="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="Home">VIBRUM</a>

    <ul class="nav-links" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={['nav-link', { 'nav-link--active': isActive(href) }]}>
            {label}
          </a>
        </li>
      ))}
    </ul>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>

  <div class="nav-accent-rule"></div>
</nav>

<!-- Drawer -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-label="Navigation">
  <ul role="list">
    {links.map(({ href, label }) => (
      <li>
        <a href={href} class:list={['mobile-menu-link', { 'mobile-menu-link--active': isActive(href) }]}>
          {label}
        </a>
      </li>
    ))}
  </ul>

  <p class="mobile-menu-copyright">&copy; 2026 Vibrum Guitars</p>
</div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-bg);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.2em;
    color: var(--color-text-bold);
    transition: color var(--transition);
    transition: letter-spacing 0.2s ease
  }

  .nav-logo:hover {
    color: var(--color-accent);
    letter-spacing: 6px;
  }

  .nav-links {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition), transform var(--transition);
    display: inline-block;
  }

  .nav-link:hover {
    color: var(--color-text-bold);
    transform: scale(1.05);
  }

  .nav-link--active {
    color: var(--color-text-bold);
  }

  .nav-accent-rule {
    height: 2px;
    background: linear-gradient(to right, transparent, var(--color-accent), transparent);
    opacity: 0.5;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 4px;
  }

  .nav-toggle-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-text-muted);
    transition: background-color var(--transition);
  }

  .nav-toggle:hover .nav-toggle-bar {
    background-color: var(--color-text-bold);
  }

  /* Drawer overlay */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s 0.35s;
    visibility: hidden;
  }

  .mobile-menu.is-open {
    transform: translateX(0);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s 0s;
    visibility: visible;
  }

  /* Links */
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-menu-link {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    position: relative;
    transition: color 0.25s ease, letter-spacing 0.25s ease;
  }

  .mobile-menu-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.25s ease;
  }

  .mobile-menu-link:hover {
    color: var(--color-text-bold);
    letter-spacing: 0.2em;
  }

  .mobile-menu-link:hover::after {
    width: 100%;
  }

  .mobile-menu-link--active {
    color: var(--color-text-bold);
  }

  .mobile-menu-link--active::after {
    width: 100%;
  }

  .mobile-menu-copyright {
    position: absolute;
    bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0px));
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-logo {
      font-size: 1.2rem;
      padding-top: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .drawer-backdrop {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu');

  function openMenu() {
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
    menu?.addEventListener('transitionend', () => {
      document.body.style.overflow = '';
    }, { once: true });
  }

  toggle?.addEventListener('click', () => {
    menu?.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (link as HTMLAnchorElement).href;
      menu?.querySelectorAll('.mobile-menu-link--active').forEach(el => {
        el.classList.remove('mobile-menu-link--active');
      });
      setTimeout(() => { window.location.href = href; }, 400);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
